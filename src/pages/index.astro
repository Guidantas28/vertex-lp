---
// Landing oficial VOS · Landing VOS estilo "big SaaS": hero de tipografia gigante, faixas dark
// com bento do Zé, editorial do mascote e CTA em gradiente granulado.
// Tokens locais no namespace .zx; motion CSS + IntersectionObserver (sem libs).
import Base from "../layouts/Base.astro";
import Nav4 from "../components/v4/Nav4.astro";
import HeroFilm4 from "../components/v4/HeroFilm4.astro";
import ScrollBand from "../components/site/ScrollBand.astro";
import Canais4 from "../components/v4/Canais4.astro";
import SegmentSolutions from "../components/site/SegmentSolutions.astro";
import FeaturesBento4 from "../components/v4/FeaturesBento4.astro";
import CtaMid4 from "../components/v4/CtaMid4.astro";
import PontaAPonta from "../components/v4/PontaAPonta.astro";
import Vitrine4 from "../components/v4/Vitrine4.astro";
import Solucoes3 from "../components/v4/Solucoes3.astro";
import Passos3 from "../components/v4/Passos3.astro";
import Bento5 from "../components/v4/Bento5.astro";
import Capacidades4 from "../components/v4/Capacidades4.astro";
import Ambos4 from "../components/v4/Ambos4.astro";
import ZeHero4 from "../components/v4/ZeHero4.astro";
import ZeAI4 from "../components/v4/ZeAI4.astro";
import Roi4 from "../components/v4/Roi4.astro";
import Depoimentos4 from "../components/v4/Depoimentos4.astro";
import Pricing4 from "../components/v4/Pricing4.astro";
import Faq4 from "../components/v4/Faq4.astro";
import TestimonialsMarquee4 from "../components/v4/TestimonialsMarquee4.astro";
import CtaFinal4 from "../components/v4/CtaFinal4.astro";
import LeadWizardModal from "../components/islands/LeadWizardModal.tsx";
import ModoZe from "../components/islands/ModoZe.tsx";
import ConfetePrecos from "../components/islands/ConfetePrecos.tsx";
import { SITE } from "../data/content";
// A casca do site (tokens .zx, tipografia, botões) mora em styles/zx.css
// desde 15/09: a página de preço precisa da MESMA casca, e ela morava aqui.
import "../styles/zx.css";
---

<Base
  title="VOS · Prospecte, automatize, venda e controle. Em um lugar só."
  description="O sistema completo da sua empresa com o Zé, a IA que executa: prospecta, responde clientes, cobra e agenda por você. CRM, WhatsApp, loja, agenda e financeiro num preço só."
  initialTheme="light"
>
  <script is:inline define:vars={{ signupUrl: SITE.signupUrl }}>
    window.__VOS_SIGNUP_URL__ = signupUrl;
  </script>
  <div class="zx zx--film">
    <Nav4 />
    <main>
      <HeroFilm4 />
      {/* A "folha": tudo depois do hero sobe por cima dele no scroll (hero fica sticky embaixo). */}
      <div class="zx-sheet">
      {/* Faixa escura: segmentos + features */}
      <ScrollBand estatica>
        <Canais4 />
        <SegmentSolutions />
        {/* 15/09: o bento "Tudo que sua empresa usa" saiu do ar pra prova do
            "Você pede. O VOS faz." ocupar este lugar, na mesma faixa escura.
            Fica aqui, não apagado, até o veredito. */}
        {/* <FeaturesBento4 /> */}
        <PontaAPonta />
        {/* 15/09: a cena do Zé saiu do ar a pedido do founder. Fica aqui, não
            apagada, até o veredito.
            AVISO PRA QUANDO VOLTAR: a lead dela diz "pelo Slack", e o Slack NÃO
            é canal do VOS . o que existe é o VOS Crew, backoffice interno da
            Vertex, só pra staff. Nenhum cliente fala com o Zé por lá. */}
        {/* <Vitrine4 /> */}
        {/* 15/09: o CTA do meio saiu do ar a pedido do founder. Fica aqui, não
            apagado, até o veredito. */}
        {/* <CtaMid4 /> */}
      </ScrollBand>
      {/* 15/09: o "Serviço e produto rodam no mesmo lugar" virou os três passos
          que trocam com o scroll. Fica aqui, não apagado, até o veredito. */}
      {/* <Ambos4 /> */}
      {/* 15/09: os três passos no lugar do bloco de soluções. Fica aqui, não
          apagado, até o veredito. */}
      {/* <Solucoes3 /> */}
      <Passos3 />
      <Bento5 />
      {/* 15/09: o MODO ZÉ, a câmera que atravessa a palavra (GlyphPortal). Hidrata
          600px antes de entrar na tela, senão quem rola rápido vê a reserva vazia. */}
      <ModoZe client:visible={{ rootMargin: "600px" }} />
      {/* 15/09: a agenda ("Sua agenda completa em um lugar") saiu do ar a
          pedido do founder. Fica aqui, não apagada, até o veredito. */}
      {/* <Capacidades4 /> */}
      {/* O resto da página volta ao papel; a folha em si é Carvão pra casar com a faixa. */}
      <div class="zx-sheet-paper">
      {/* 15/09: os quatro blocos do meio saíram do ar a pedido do founder .
          "Conheça o Zé", "Você delega. A IA faz o trabalho", "É como contratar
          um time inteiro" e "Quem entrou, não voltou pra planilha". Ficam aqui,
          não apagados, até o veredito. */}
      {/* <ZeHero4 /> */}
      {/* <ZeAI4 /> */}
      {/* <Roi4 /> */}
      {/* <Depoimentos4 /> */}
      {/* 16/09: o confete estoura quando os preços entram na tela (ConfetePrecos observa o #precos). */}
      <div class="zx-precos-palco" style="position: relative">
        <ConfetePrecos client:visible />
        <Pricing4 />
      </div>
      <Faq4 />
      <TestimonialsMarquee4 />
      <CtaFinal4 />
      </div>
      </div>
    </main>
    <LeadWizardModal client:idle />
  </div>
</Base>


<script>
  /* O que toda página tem (modal de lead + faixas que abrem) mora no
     zx-cena.ts desde 15/09, e a nav cuida de si dentro do Nav4.astro: a
     página de preço usa os dois. Aqui embaixo fica só o que é da HOME. */
  import "../scripts/zx-cena";

  // ── Tabs dos segmentos ────────────────────────────────────────────────
  document.querySelectorAll<HTMLElement>('[role="tablist"]').forEach((list) => {
    const tabs = Array.from(list.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const select = (tab: HTMLButtonElement) => {
      tabs.forEach((t) => {
        const panel = document.getElementById(t.getAttribute("aria-controls") || "");
        const on = t === tab;
        t.setAttribute("aria-selected", String(on));
        if (panel) panel.hidden = !on;
      });
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => select(t));
      t.addEventListener("keydown", (ev) => {
        if (ev.key !== "ArrowRight" && ev.key !== "ArrowLeft") return;
        ev.preventDefault();
        const next = tabs[(i + (ev.key === "ArrowRight" ? 1 : tabs.length - 1)) % tabs.length];
        next.focus();
        select(next);
      });
    });
  });

  // ── Tilt 3D nos cards (só ponteiro fino, sem reduced motion) ──────────
  const fine = matchMedia("(pointer: fine)").matches;
  const noMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (fine && !noMotion) {
    document.querySelectorAll<HTMLElement>("[data-tilt]").forEach((card) => {
      let raf = 0;
      card.addEventListener("pointermove", (ev) => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          const r = card.getBoundingClientRect();
          const px = (ev.clientX - r.left) / r.width - 0.5;
          const py = (ev.clientY - r.top) / r.height - 0.5;
          card.style.transform = `perspective(900px) rotateX(${(-py * 6).toFixed(2)}deg) rotateY(${(px * 8).toFixed(2)}deg) translateY(-2px)`;
        });
      });
      card.addEventListener("pointerleave", () => {
        cancelAnimationFrame(raf);
        card.style.transform = "";
      });
    });
  }

  // ── Parallax do Zé no editorial ───────────────────────────────────────
  if (!noMotion) {
    const targets = document.querySelectorAll<HTMLElement>("[data-parallax]");
    if (targets.length) {
      let ticking = false;
      const update = () => {
        ticking = false;
        const vh = innerHeight;
        targets.forEach((el) => {
          const r = el.getBoundingClientRect();
          if (r.bottom < 0 || r.top > vh) return;
          const p = (r.top + r.height / 2 - vh / 2) / vh; // -0.5..0.5
          el.style.transform = `translateY(${(p * -42).toFixed(1)}px)`;
        });
      };
      addEventListener(
        "scroll",
        () => {
          if (!ticking) { ticking = true; requestAnimationFrame(update); }
        },
        { passive: true }
      );
      update();
    }
  }
</script>
