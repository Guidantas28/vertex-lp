---
// Rota /lp · landing de campanha (anúncios). Documento próprio: o HTML, o CSS
// e o JS vêm do repo vertex-lp e ficam intactos (`is:inline`), sem o chrome
// da home (Nav/Footer/tema). O que é compartilhado com o resto do site:
//   · GTM + primeiro toque (vos_ft)                     -> GtmHead/GtmNoScript/FirstTouch
//   · CTA -> mesma modal de lead (2 etapas) -> Cal.com  -> <LeadWizardModal/>
// Os CTAs têm data-action="lead"; o listener no fim do body dispara o evento
// "vos:open-lead", exatamente como na home.
import "../styles/lp.css";
import GtmHead from "../components/tracking/GtmHead.astro";
import GaHead from "../components/tracking/GaHead.astro";
import GtmNoScript from "../components/tracking/GtmNoScript.astro";
import FirstTouch from "../components/tracking/FirstTouch.astro";
import LeadWizardModal from "../components/islands/LeadWizardModal.tsx";

const title = "VOS · Atendimento automático é só o começo";
const description =
  "No VOS, uma ação puxa a próxima: a mensagem vira atendimento, o atendimento vira negócio, e o negócio vira agenda e caixa. Sem ninguém precisar lembrar do passo seguinte.";
// Domínio REAL do site (o `site` do astro.config aponta pra osvertex.com, que
// hoje devolve 404 — canonical/og apontando pra lá quebrariam preview e SEO).
const SITE_URL = "https://www.voshq.com";
const url = `${SITE_URL}/lp`;
const ogImage = `${SITE_URL}/og.png`;

// Fonte ÚNICA dos planos (a spec §8 exige centralizar pra não divergir entre
// blocos). Valores e itens vêm SÓ do PRECOS_VOS_ATUAL.png. O que não estava
// legível na fonte não foi inventado — ver docs/vos-growth/LP_ARCHITECTURE.md.
const PLANOS = [
  {
    nome: "Start",
    preco: "297",
    beneficio: "Para começar a centralizar a operação e automatizar os primeiros processos.",
    resumo: null,
    itens: [
      "1 usuário",
      "CRM, atendimento em 2 canais e orçamentos",
      "Agenda, contatos e até 10 automações",
      "Estoque, pedidos, ordem de serviço e assinaturas",
      "Contas a pagar, receber e fornecedores",
    ],
    cta: "Ver o Start na demonstração",
  },
  {
    nome: "Essential",
    preco: "497",
    beneficio: "Para equipes que precisam conectar atendimento, vendas e operação.",
    resumo: "Tudo do Start, mais:",
    itens: [
      "5 usuários e atendimento em até 5 canais",
      "Assinatura digital — até 20 por mês",
      "Catálogo digital",
      "Nota fiscal",
      "Relatórios",
    ],
    cta: "Ver o Essential na demonstração",
    selo: "Mais escolhido",
  },
  {
    nome: "Scale",
    preco: "797",
    beneficio: "Para operações com mais pessoas, canais e volume.",
    resumo: "Tudo do Essential, mais:",
    itens: [
      "15 usuários",
      "Até 20 canais de atendimento",
      "Assinaturas digitais ilimitadas",
      "PDV",
    ],
    cta: "Ver o Scale na demonstração",
  },
];
---

<!doctype html>
<html lang="pt-BR">
<head>
  <GtmHead />
  <GaHead />
<meta charset="utf-8">
<script is:inline>document.documentElement.classList.add("js")</script>
<meta name="viewport" content="width=device-width, initial-scale=1">
<!-- Mesma marca do app (apps/web/app/icon.png), pra aba e atalho baterem com o produto -->
<link rel="icon" type="image/png" sizes="32x32" href="/lp/favicon.png">
<link rel="icon" type="image/png" sizes="192x192" href="/lp/icon-192.png">
<link rel="icon" type="image/png" sizes="512x512" href="/lp/icon-512.png">
<link rel="apple-touch-icon" href="/lp/apple-touch-icon.png">
<meta name="theme-color" content="#0d0d0d">
<meta name="description" content="Atendimento automático é só o começo. No VOS, uma ação puxa a próxima — do primeiro oi ao dinheiro no caixa.">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<!-- Tipografia oficial do VOS: Inter em TUDO (DS §4/§18). A voz manuscrita da
     campanha é fonte de sistema e não passa por aqui. -->
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <!-- Fontes da modal de lead (Geist/Jakarta/JetBrains Mono), pro wizard ficar
       igual ao do resto do site. A LP em si é Inter. -->
  <link
    href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
    rel="stylesheet"
  />
  <title>{title}</title>
  <link rel="canonical" href={url} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={url} />
  <meta property="og:locale" content="pt_BR" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
</head>
<body>
<GtmNoScript />

<div class="wrap">
  <div class="hdr">
    <div class="logo">
      <img src="/lp/vos-logo-mono-dark.png" alt="VOS" width="901" height="277">
    </div>
  </div>

  <!-- 1 | HERO. Message match com o Control: quem clicou no anuncio de
       "atendimento automatico" reconhece a pagina e e levado uma casa
       adiante. O H1 anterior ("a maneira mais facil ... em um so lugar")
       era o descritor de produto vendido como manchete, e brigava com a
       tese da secao seguinte. -->
  <section class="hero">
    <div class="eb"><u>para empresas que vivem de WhatsApp<svg viewBox="0 0 240 10" preserveAspectRatio="none"><path d="M2 7.4C46 3.1 120 1.9 178 3.4c22 .6 46 1.9 60 3.6"/></svg></u></div>
    <h1>Atendimento automático<br><em>é só o começo.</em></h1>
    <p class="lead">Atendimento, CRM, vendas, orçamento, contratos, agenda, serviços, financeiro e automações trabalhando dentro do mesmo sistema</p>
    <a href="#agendar" class="cta" data-action="lead">Agendar demonstração<svg class="ar" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    <p class="atrito">30 minutos, sem cartão e sem instalar nada. Você vê o sistema por dentro, módulo por módulo, e pergunta o que quiser — ao vivo.</p>
    <div class="badges">
      <div class="proof">
        <div class="pf">
          <svg class="pf-meta" viewBox="0 0 36 20" fill="none" stroke="currentColor"
               stroke-width="2.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 10c2.6-4.6 4.9-6.6 7.6-6.6 3.4 0 5.9 3 5.9 6.6s-2.5 6.6-5.9 6.6c-2.7 0-5-2-7.6-6.6-2.6-4.6-4.9-6.6-7.6-6.6C7 3.4 4.5 6.4 4.5 10s2.5 6.6 5.9 6.6c2.7 0 5-2 7.6-6.6Z"/>
          </svg>
          <span class="pf-txt"><b>Meta</b> Business Partner</span>
        </div>

        <span class="pf-sep" aria-hidden="true"></span>

        <div class="pf">
          <img class="pf-logo" src="/lp/vos-logo-mono-dark.png" alt="VOS" width="901" height="277">
        </div>
      </div>
      <div class="integr">
        <div class="ics">
          <span class="ic" style="border-color:#25D366" title="WhatsApp"><svg viewBox="0 0 24 24" fill="#25D366"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm5.7 14.1c-.2.7-1.4 1.4-2 1.4-.5 0-1.1.2-3.7-.8-3.1-1.3-5-4.4-5.2-4.6-.1-.2-1.2-1.5-1.2-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.3.4-.4.5c-.1.1-.3.3-.1.6a9 9 0 0 0 1.5 1.8 8 8 0 0 0 2.1 1.3c.3.1.4.1.6-.1l.8-1c.2-.2.3-.2.6-.1l1.8.9c.3.1.4.2.5.3.1.2.1.7-.1 1.4Z"/></svg></span>
          <span class="ic" style="border-color:#D6249F" title="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="#D6249F" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5.4"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1.2" fill="#D6249F" stroke="none"/></svg></span>
          <span class="ic" style="border-color:#0084FF" title="Messenger"><svg viewBox="0 0 24 24" fill="#0084FF"><path d="M12 2C6.3 2 2 6.2 2 11.7c0 3.1 1.4 5.9 3.7 7.7v3.1l3.4-1.9c.9.3 1.9.4 2.9.4 5.7 0 10-4.2 10-9.7S17.7 2 12 2Zm1 13-2.6-2.7L5.6 15l5.3-5.6 2.6 2.7L18.3 9 13 15Z"/></svg></span>
          <span class="ic" style="border-color:#0866FF" title="Meta"><svg viewBox="0 0 24 24" fill="none" stroke="#0866FF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.6 14.3c0-3.6 1.8-6.6 4-6.6 1.3 0 2.3 1 3.5 2.9 1.4 2.2 2.3 3.6 2.3 3.6 1.4 2.2 2.1 2.9 3.2 2.9 1.4 0 2.5-1.3 2.5-3.4 0-2.4-1.1-4.9-2.9-4.9-1 0-2 .7-3.3 2.5"/><path d="M9.5 9.4C8.2 7.6 7.1 6.7 5.9 6.7c-2.4 0-4.3 3.2-4.3 7.2 0 2.1 1 3.5 2.6 3.5 1.2 0 2.1-.6 3.6-2.9"/></svg></span>
          <span class="ic" style="border-color:#111" title="TikTok"><svg viewBox="0 0 24 24" fill="#111"><path d="M16.6 2h-3v13.2a2.6 2.6 0 1 1-2.2-2.6V9.5a5.8 5.8 0 1 0 5.2 5.8V8.9c1.1.8 2.4 1.2 3.8 1.3V7.1a4.3 4.3 0 0 1-3.8-5.1Z"/></svg></span>
          <span class="ic" style="border-color:#29A9EA" title="Telegram"><svg viewBox="0 0 24 24" fill="#29A9EA"><path d="M21.7 3.3 2.9 10.6c-1 .4-1 1.4 0 1.7l4.7 1.5 1.8 5.5c.2.6.4.8 1 .8.5 0 .7-.2 1-.6l2.3-2.2 4.7 3.5c.9.5 1.5.2 1.7-.8l3.1-14.6c.3-1.2-.5-1.8-1.5-1.4ZM8.9 13.3l9.2-5.8-7.7 6.8-.3 3.2-1.2-4.2Z"/></svg></span>
          <span class="ic" style="border-color:#D97757" title="Claude"><svg viewBox="0 0 24 24" fill="none" stroke="#D97757" stroke-width="1.9" stroke-linecap="round"><path d="M12 2.6v18.8M3.4 12h17.2M5.5 5.5l13 13M18.5 5.5l-13 13"/><path d="M8.4 3.6 15.6 20.4M15.6 3.6 8.4 20.4M3.6 8.4l16.8 7.2M3.6 15.6l16.8-7.2" opacity=".55"/></svg></span>
        </div>
        <span class="lb">Integrações oficiais</span>
      </div>
    </div>

  </section>

  <!-- A cara do sistema. Mesma imagem que está no hero de voshq.com
       (/assets/hero/dashboard.webp, usada pelo Hero4 da home) — aqui em
       moldura contida em vez do palco sangrado da home, porque a /lp é
       centralizada. width/height batem com o arquivo (3200x1900) para
       não gerar CLS; eager porque é provável elemento LCP. -->
  <figure class="hero-tela reveal">
    <img src="/assets/hero/dashboard.webp"
         alt="Tela do VOS: painel com funil de venda, receita, fluxo de caixa e o menu de módulos à esquerda"
         width="3200" height="1900" loading="eager" fetchpriority="high" decoding="async">
  </figure>

  <div class="band">
    <svg class="band-top" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 0H1440v80C1040 4 400 4 0 80Z" fill="var(--bg)"/>
    </svg>
    <!-- Aqui viviam o bloco de problema, a faixa do mecanismo e as tres
         provas vivas. Removidos a pedido do Orlando em 19/08 — a area fica
         vazia de proposito, para ser refeita. Os motores animados que os
         moviam sairam no commit d3ce2f2, JS e CSS na mesma passada: nao ha
         nada orfao aqui esperando a marcacao voltar. -->

    <!-- ══ Fluxo Contínuo VOS ══
         Aqui vivia a CADEIA: 9 etapas em 3 fases, dois estados ("Do jeito
         manual" x "Com o VOS"), selo por cartao, relogio no cartao 3 e uma
         cena animada em video por cartao. Removida a pedido do Orlando em
         19/08 — fica so a copy do cabecalho. O motor (JS) saiu junto, na
         mesma passada; o CSS ficou pela metade e so foi limpo depois — as
         regras .fluxo* e as @keyframes cn-* seguiam mortas no fim do lp.css.
         A nota de WCAG 2.2.2 que morava naquele bloco NAO foi apagada: ela
         trocou de dono e hoje esta junto da esteira de depoimentos, que e
         quem move sozinho agora.
         Os renders /lp/cena-trabalho.{webm,mp4,png} foram APAGADOS em 20/08:
         eram 1,1 MB sem referencia nenhuma, indo junto em todo deploy. O fonte
         que os gera segue versionado (LpCenaTrabalho, commit e7ef105 do
         D:VIDEO-FACTORY) — se a cadeia voltar, e so renderizar de novo. -->
    <div class="band-head band-head-2">
      <div class="eb"><u>você digita uma vez só<svg viewBox="0 0 240 10" preserveAspectRatio="none"><path d="M2 7.4C46 3.1 120 1.9 178 3.4c22 .6 46 1.9 60 3.6"/></svg></u></div>
      <h2>A conversa no WhatsApp <u>já é o orçamento, o pedido e a nota fiscal.</u></h2>
      <p>O cliente escreve. O VOS responde, salva o contato, monta o orçamento e emite a nota. Nada é copiado de uma tela para outra.</p>
    </div>

    <!-- ══ A CENA: a conversa de um lado, os modulos do outro ══
         Video, e nao animacao de DOM: sao 14 bolhas com rolagem, indicador de
         digitacao e sete acendimentos sincronizados. Em JS isso seria um motor
         novo na pagina — e motor na pagina foi exatamente a divida que a
         limpeza de 19/08 pagou. Fonte da peca versionado em
         D:VIDEO-FACTORY (composicao VosPainelWhats).

         Desde 20/08 e UM arquivo so, entao os <source> voltaram a ser
         estaticos: nao existe mais troca por matchMedia, e quem esta sem JS
         recebe a peca certa. O corte deitado morreu por geometria — num quadro
         largo o aparelho ja ocupava toda a altura, entao o painel lateral nao
         dava espaco a tela, so aumentava o vazio dos lados.

         🔴 SEM BOTAO DE PAUSAR, e isso tem custo. Movimento que comeca sozinho,
         passa de 5s e divide a tela com texto exige um mecanismo de pausar
         (WCAG 2.2.2, nivel A). Sem o botao nao existe mecanismo nenhum, e a
         pagina REPROVA nesse criterio — ela tinha acabado de passar a cumprir,
         em 20/08, quando a esteira de depoimentos saiu. E decisao do Orlando,
         tomada com o custo na mesa: ele quer que leia como GIF. A unica
         atenuacao que sobra e o prefers-reduced-motion, que nao dispara o
         autoplay. Nao e descuido; e escolha do dono. -->
    <div class="band-cena">
      <div class="cena" id="cena">
        <video id="cenaVid" class="cena-v" poster="/lp/vos-cena-poster.webp"
               playsinline muted loop preload="none" aria-label="Uma conversa de WhatsApp do primeiro contato ate a nota fiscal, com os modulos do VOS acendendo a cada etapa">
          <source src="/lp/vos-cena.webm" type="video/webm">
          <source src="/lp/vos-cena.mp4" type="video/mp4">
        </video>
      </div>
    </div>

    <!-- 6 | DO PRIMEIRO OI AO CAIXA. A spec pede continuidade, nao
         lista de features - por isso a copy narra o percurso. -->
    <div class="band-head band-head-2">
      <div class="eb"><u>Conheça o VOS<svg viewBox="0 0 240 10" preserveAspectRatio="none"><path d="M2 7.4C46 3.1 120 1.9 178 3.4c22 .6 46 1.9 60 3.6"/></svg></u></div>
      <p>Conecta atendimento, automações, vendas, notas fiscais e a gestão inteira em um único lugar.</p>
    </div>

    <div class="band-video">
      <div class="player" id="player">
        <video id="vid" src="/lp/broll.mp4#t=0.5" poster="/lp/broll-poster.jpg"
               playsinline muted preload="metadata" controlslist="nodownload"></video>
        <button type="button" class="capa" id="capa" aria-label="Assistir ao vídeo">
          <span class="play"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.2v13.6L19 12 8 5.2Z"/></svg></span>
          <span class="rot">Conheça o VOS</span>
        </button>
        <button type="button" class="som" id="som" aria-label="Ativar o som do vídeo">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5Z"/><path d="M22 9l-6 6M16 9l6 6"/></svg>
          Ativar Som
        </button>
      </div>
    </div>

    <!-- ⚰️ Aqui vivia a esteira de 15 depoimentos. Eles eram FICTICIOS — nome,
         cidade, nota e frase inventados, com numero de resultado fabricado
         ("+R$ 32 mil") — e estavam no ar com ehRascunho=false. Saem a pedido do
         Orlando em 19/08. Era o unico ponto em que a pagina contrariava a spec
         DE FRENTE ("Nenhum depoimento ficticio"); no lugar entra prova de
         mecanismo, que a spec lista ACIMA de depoimento: a cena la em cima
         mostra a venda inteira acontecendo, em vez de alguem afirmar que ela
         acontece.
         Sai junto a ultima animacao infinita da pagina (.depo-fita, 38s em
         loop, com pausa so no :hover) — com ela, a reprovacao em WCAG 2.2.2 A
         deixa de existir.
         ⚠️ As mesmas 15 fotos e os mesmos depoimentos seguem em
         src/data/content.ts, alimentando a HOME (ResultsCarousel, HeroAvatars).
         Outra superficie, outra decisao. -->

    <!-- 8 | PRECOS. Value stack antes do numero, e os planos saem do array
         PLANOS do frontmatter - fonte unica, como a spec exige. Valores e
         itens vem SO do PRECOS_VOS_ATUAL.png; o que nao estava legivel na
         fonte nao foi inventado (ver docs/vos-growth/LP_ARCHITECTURE.md). -->
    <div class="band-head band-head-2 planos-sep">
      <div class="eb"><u>quanto custa<svg viewBox="0 0 240 10" preserveAspectRatio="none"><path d="M2 7.4C46 3.1 120 1.9 178 3.4c22 .6 46 1.9 60 3.6"/></svg></u></div>
      <h2>Um sistema para a empresa inteira.</h2>
      <p class="stack">Atendimento, CRM, automações, agenda, operação e financeiro trabalhando juntos.</p>
      <p class="ancora">Planos a partir de <b>R$ 297/mês</b>.</p>
    </div>

    <div class="planos reveal">
      {PLANOS.map((pl) => (
        <article class={pl.selo ? "plano plano-destaque" : "plano"}>
          <div class="plano-topo">
            <h3 class="plano-nome">{pl.nome}</h3>
            {pl.selo && <span class="plano-selo">{pl.selo}</span>}
          </div>
          <p class="plano-preco"><b>R$ {pl.preco}</b><span>/mês</span></p>
          <p class="plano-benef">{pl.beneficio}</p>
          {pl.resumo && <p class="plano-resumo">{pl.resumo}</p>}
          <ul class="plano-itens">
            {pl.itens.map((it) => <li>{it}</li>)}
          </ul>
          <a href="#agendar" class="cta cta-2" data-action="lead">{pl.cta}<svg class="ar" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </article>
      ))}
    </div>

    <!-- Reduz a paralisia de escolher entre tres opcoes: em vez de mandar a
         pessoa decidir sozinha, joga a decisao pra dentro da demonstracao. -->
    <div class="ajuda">
      <svg class="ajuda-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.2a2.6 2.6 0 1 1 3.4 2.5c-.6.2-.9.7-.9 1.3v.4"/><path d="M12 16.8h.01"/></svg>
      <p class="ajuda-t">Não sabe qual plano faz sentido para a sua empresa?</p>
      <p class="ajuda-alivio">Você não precisa decidir agora.</p>
      <p class="ajuda-p">Na demonstração a gente entende como a sua operação funciona e mostra qual plano cobre o que você realmente precisa.</p>
      <a href="#agendar" class="ajuda-cta" data-action="lead">Me ajuda a escolher<svg class="ar" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </div>

    <!-- 9 | OBJECOES. As seis da spec. As respostas usam so fato ja afirmado
         no produto ou na tabela acima - nada de politica de implantacao ou
         de suporte inventada. -->
    <div class="band-head band-head-2">
      <div class="eb"><u>sem letra miúda<svg viewBox="0 0 240 10" preserveAspectRatio="none"><path d="M2 7.4C46 3.1 120 1.9 178 3.4c22 .6 46 1.9 60 3.6"/></svg></u></div>
      <h2>O que você precisa saber <u>antes de decidir</u>.</h2>
    </div>

    <div class="faq">
        <details class="faq-item">
          <summary>Já tenho outro sistema. Preciso trocar tudo?<i class="faq-sinal" aria-hidden="true"></i></summary>
          <p>Não precisa. Ele continua onde está, se você quiser. O time do VOS traz os seus dados — contatos, produtos, financeiro — para dentro do sistema, como já fez com todos os clientes até hoje. E como o VOS é modular, você liga só o que vai usar e mantém o resto rodando em paralelo.</p>
        </details>
        <details class="faq-item">
          <summary>Vou precisar parar minha operação para implantar o VOS?<i class="faq-sinal" aria-hidden="true"></i></summary>
          <p>Não. Quem implanta é o time do VOS — você não monta nada. Pedimos até 7 dias para entregar o sistema pronto, com os seus dados dentro e a sua operação já funcionando, e na maioria das vezes entregamos antes.</p>
        </details>
        <details class="faq-item">
          <summary>E se minha equipe não estiver acostumada com sistemas?<i class="faq-sinal" aria-hidden="true"></i></summary>
          <p>Todo cliente entra num grupo de suporte direto com o time do VOS. Dúvida ou dificuldade, é mandar mensagem no grupo — em menos de 5 minutos tem alguém te socorrendo. E o sistema foi desenhado para quem não é de tecnologia: quem usa WhatsApp usa o VOS.</p>
        </details>
        <details class="faq-item">
          <summary>Funciona com o WhatsApp que a gente já usa?<i class="faq-sinal" aria-hidden="true"></i></summary>
          <p>Funciona com o número que você já usa — não precisa de número novo. O histórico entra junto: seus contatos e as conversas que já existem aparecem dentro do VOS. E o seu celular continua funcionando normalmente. A conexão é pela API oficial da Meta, de quem o VOS é parceiro.</p>
        </details>
        <details class="faq-item">
          <summary>O VOS faz sentido para uma empresa pequena?<i class="faq-sinal" aria-hidden="true"></i></summary>
          <p>Faz — e é onde ele mais muda o jogo. Uma empresa de uma pessoa passa a operar com o mesmo sistema que uma empresa grande usa: atendimento, CRM, agenda, operação e financeiro no mesmo lugar, por um valor bem abaixo do que ela paga. O plano acompanha o tamanho da operação; a estrutura, não.</p>
        </details>
        <details class="faq-item">
          <summary>Preciso contratar todos os módulos de uma vez?<i class="faq-sinal" aria-hidden="true"></i></summary>
          <p>Você não paga por módulo. O plano já vem com o conjunto operacional — atendimento, CRM, agenda, estoque, pedidos e financeiro — e você liga só o que for usar. O que muda de um plano para o outro é o tamanho: usuários, canais e alguns recursos como catálogo digital, nota fiscal e PDV.</p>
        </details>
        <details class="faq-item">
          <summary>O que a IA faz, na prática?<i class="faq-sinal" aria-hidden="true"></i></summary>
          <p>Chega uma mensagem no WhatsApp vinda do anúncio. A IA responde em menos de 5 minutos, qualifica, manda o orçamento, fecha a venda, envia o link de pagamento e emite a nota fiscal — enquanto você dorme ou cuida de outra parte da empresa. E ela sabe a hora de sair de cena: desconto fora da tabela, reclamação ou pedido fora do catálogo vão para uma pessoa.</p>
        </details>
