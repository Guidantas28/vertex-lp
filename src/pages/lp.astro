<script is:inline>



  /* ── A cena ────────────────────────────────────────────────────────────
     Um arquivo so desde 20/08, entao aqui sobrou o essencial: tocar quando
     entra na tela, parar quando sai. A escolha de corte por matchMedia morreu
     junto com o corte deitado, e o botao de pausar saiu a pedido dele — a cena
     tem que ler como GIF.

     🔴 Sem o botao a pagina REPROVA em WCAG 2.2.2 nivel A. Esta escrito no
     comentario do markup, no LP_ARCHITECTURE.md e no RELATORIO-FINAL.md. A
     unica atenuacao que sobra e a linha do prefers-reduced-motion aqui embaixo.

     preload="none" + IntersectionObserver: nada e buscado ate a secao entrar
     na tela. Um visitante baixa UM arquivo — 594 kB no webm (Chrome, Firefox,
     Edge e Safari 14.1+) ou 1615 kB no mp4, que e a queda pra quem nao toca
     webm. O broll que ja esta nesta pagina pesa 2013 kB. */
  (function(){
    var cena=document.getElementById('cena'), vid=document.getElementById('cenaVid');
    if(!cena||!vid) return;
    if(matchMedia('(prefers-reduced-motion: reduce)').matches) return; // fica o poster
    if(!('IntersectionObserver' in window)) return;
    new IntersectionObserver(function(es){
      es.forEach(function(e){
        if(e.isIntersecting){ vid.play().catch(function(){}); }
        else if(!vid.paused){ vid.pause(); }
      });
    },{threshold:.35}).observe(cena);
  })();

  var io=new IntersectionObserver(function(es){es.forEach(function(e){
    if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});},{threshold:.14});
  document.querySelectorAll('.reveal').forEach(function(el){io.observe(el);});


  /* ── WhatsApp flutuante ────────────────────────────────────────────────
     Monta o link na hora do clique para carregar um `event_id` novo a cada
     vez, e empurra `clique_whatsapp` no dataLayer com os identificadores do
     primeiro toque. O GTM ainda NÃO consome este evento — standby pedido pelo
     Orlando em 19/08. Quando consumir, o event_id daqui é o mesmo que vai no
     texto da conversa, e é por ele que a conversão do WhatsApp se casa com a
     sessão do site (e sustenta o EMQ na Meta). */
  (function(){
    var a=document.getElementById('zap'); if(!a) return;
    var NUM='5543996885300';

    function primeiroToque(){
      var out={};
      try{
        var m=document.cookie.match('(?:^|; )vos_ft=([^;]*)');
        if(!m) return out;
        var ft=JSON.parse(decodeURIComponent(m[1]));
        ['fbp','fbc','fbclid','gclid'].forEach(function(k){ if(ft[k]) out[k]=ft[k]; });
        if(ft.clientId) out.client_id=ft.clientId;
        if(ft.stapeUserId) out.stape_user_id=ft.stapeUserId;
      }catch(e){}
      return out;
    }

    function novoId(){
      try{ if(crypto&&crypto.randomUUID) return crypto.randomUUID().slice(0,8); }catch(e){}
      return (Date.now().toString(36)+Math.random().toString(36).slice(2,6));
    }

    /* o balao entra uma vez por sessao, depois do hero */
    var balao=document.getElementById('zapBalao');
    var fechar=document.getElementById('zapX');
    var CHAVE='vos_zap_dispensado';
    var jaFoi=false;
    function mostraBalao(){
      if(jaFoi||!balao) return;
      try{ if(sessionStorage.getItem(CHAVE)) return; }catch(e){}
      jaFoi=true; balao.hidden=false;
      requestAnimationFrame(function(){ balao.classList.add('in'); });
    }
    if(fechar) fechar.addEventListener('click',function(){
      balao.classList.remove('in');
      setTimeout(function(){ balao.hidden=true; }, 240);
      try{ sessionStorage.setItem(CHAVE,'1'); }catch(e){}
    });
    (function(){
      var disparou=false;
      function confere(){
        if(disparou||scrollY<520) return;
        disparou=true; window.removeEventListener('scroll',confere);
        setTimeout(mostraBalao, 1400);
      }
      window.addEventListener('scroll',confere,{passive:true});
      confere();
    })();

    a.addEventListener('click',function(){
      var id=novoId();
      var texto='Oi! Vim pelo site do VOS e quero entender como funciona. (ref '+id+')';
      a.href='https://wa.me/'+NUM+'?text='+encodeURIComponent(texto);
      var dados=primeiroToque();
      dados.event='clique_whatsapp';
      dados.event_id=id;
      window.dataLayer=window.dataLayer||[];
      window.dataLayer.push(dados);
    });
  })();

  /* player: toca sozinho (mudo) quando entra na tela e pausa quando sai.
     Autoplay com som é bloqueado em todo navegador, então o som fica a um
     toque de distância no chip. Capa e clique seguem valendo como caminho
     manual — inclusive quando o autoplay é recusado. */
  (function(){
    var pl=document.getElementById('player'), vid=document.getElementById('vid'),
        capa=document.getElementById('capa'), som=document.getElementById('som');
    if(!pl||!vid||!capa) return;
    var comSom=false;

    function ligaSom(){
      comSom=true; vid.muted=false; vid.controls=true;
      pl.classList.add('on','audio');
      vid.play();
    }
    capa.addEventListener('click',ligaSom);
    if(som) som.addEventListener('click',ligaSom);

    var reduz=matchMedia('(prefers-reduced-motion: reduce)').matches;
    if(!reduz && 'IntersectionObserver' in window){
      var dentro=false;
      function tenta(){
        if(!dentro) return;
        if(!comSom) vid.muted=true;
        var p=vid.play();
        // só some com a capa se o navegador REALMENTE deixou tocar
        if(p&&p.then) p.then(function(){pl.classList.add('on');}).catch(function(){});
      }
      // quem cai na página com o player já na tela (scroll restaurado, voltar
      // do histórico) pede play antes de ter mídia: o canplay tenta de novo
      vid.addEventListener('canplay',tenta);
      new IntersectionObserver(function(es){
        es.forEach(function(e){
          dentro=e.isIntersecting;
          if(dentro) tenta();
          else if(!vid.paused) vid.pause();
        });
      },{threshold:.55}).observe(pl);
    }

    // no fim volta a capa, e o próximo play recomeça mudo
    vid.addEventListener('ended',function(){
      pl.classList.remove('on','audio'); vid.controls=false; comSom=false;
    });
  })();

  /* barra fixa: entra depois do primeiro scroll e SAI quando o CTA de verdade
     (o do fim da faixa) está na tela, senão a página termina com dois botões
     laranja idênticos empilhados */
  (function(){
    var bar=document.getElementById('bar'), fim=document.querySelector('.band-cta');
    function atualiza(){
      var naTela=false;
      if(fim){ var r=fim.getBoundingClientRect(); naTela = r.top < innerHeight-40 && r.bottom > 0; }
      bar.classList.toggle('show', scrollY>480 && !naTela);
    }
    /* getBoundingClientRect a cada scroll força layout; coalesce num rAF */
    var raf=0;
    function agenda(){ if(raf) return; raf=requestAnimationFrame(function(){ raf=0; atualiza(); }); }
    addEventListener('scroll',agenda,{passive:true});
    addEventListener('resize',agenda,{passive:true});
    atualiza();
  })();

</script>

