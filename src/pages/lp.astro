      return '<div class="depo"><div class="depo-estrelas">★★★★★<em>'+d[4]+'</em></div><p>'+d[5]+'</p>'+
        '<div class="depo-quem"><img class="depo-av" src="/lp/pessoas/'+d[0]+'.webp" alt="" loading="lazy" width="56" height="56">'+
        '<span><b>'+d[1]+'</b><span>'+d[2]+' · '+d[3]+'</span></span></div></div>';
    }
    var pistas=innerWidth>=760?3:1, veloc=['38s','46s','42s'];
    function monta(){
      var n=innerWidth>=760?3:1;
      if(n===pistas && caixa.children.length) return;   // só remonta se mudou de faixa
      pistas=n; caixa.innerHTML='';
      for(var p=0;p<n;p++){
        var lista=DEPOIMENTOS.filter(function(_,i){ return n===1 || i%n===p; });
        var fita=lista.map(cartao).join('');
        caixa.insertAdjacentHTML('beforeend',
          '<div class="depo-pista"><div class="depo-fita" style="--v:'+veloc[p]+'">'+fita+fita+'</div></div>');
      }
    }
    monta();
    addEventListener('resize',monta,{passive:true});
    if(ehRascunho){
      caixa.classList.add('rascunho');
      caixa.insertAdjacentHTML('afterend',
        '<p class="depos-aviso">Rascunho: trocar pelos depoimentos reais antes de publicar.</p>');
    }
  })();

  var io=new IntersectionObserver(function(es){es.forEach(function(e){
    if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});},{threshold:.14});
  document.querySelectorAll('.reveal').forEach(function(el){io.observe(el);});


  /* Fluxo Contínuo VOS — passada ÚNICA ao entrar na tela, depois o usuário
     manda. Sem loop (WCAG 2.2.2). O bloco é autocontido — não depende de
     registrador de timers nenhum. */
  (function(){
    var raiz=document.getElementById('fluxo'); if(!raiz) return;
    var nos=[].slice.call(raiz.querySelectorAll('.fx-no'));
    var log=document.getElementById('fluxoLog');
    var abas=[].slice.call(raiz.querySelectorAll('.fluxo-tabs .flow-tab'));
    if(!nos.length) return;
    var reduz=matchMedia('(prefers-reduced-motion: reduce)').matches;
    var estado='hoje', i=-1, t=null;

    /* onde a cadeia trava quando ninguém automatizou: todo vão depende de
       alguém lembrar. No estado "vos" nenhum trava. */
    function travaEm(k){ return estado==='hoje' && [2,5,8].indexOf(k)>=0; }

    /* ── o relógio do cartão 3 ────────────────────────────────────────────
       Só ele tem relógio: "lead chega → alguém responde" é o único elo com
       fonte pública (Opinion Box + HBR). Pôr tempo nos outros oito seria
       inventar oito durações.
       O valor final já está no HTML (data-fim) — sem JS a página mostra a
       verdade. O script só rebobina e conta até ele: os passos do meio são o
       ponteiro andando, não afirmação. Uma passada, sem loop e sem
       setInterval. */
    var RELOGIO={
      hoje:['1 min','6 min','23 min','1 h','4 h','11 h','26 h','38 h'],
      vos :['2 s','9 s','31 s','1 min','3 min']
    };
    var relogios=[].slice.call(raiz.querySelectorAll('.fx-timer'));
    var tRel=null;

    function paraRelogio(){
      clearTimeout(tRel);
      relogios.forEach(function(el){ el.textContent=el.dataset.fim; });
    }
    function rodaRelogio(){
      clearTimeout(tRel);
      if(reduz) return paraRelogio();
      var el=raiz.querySelector('.fx-timer.fx-'+(estado==='hoje'?'hoje':'vos'));
      if(!el) return;
      var passos=RELOGIO[estado], k=0;
      (function anda(){
        if(k>=passos.length){ el.textContent=el.dataset.fim; return; }
        el.textContent=passos[k++];
        tRel=setTimeout(anda,150);
      })();
    }

    function pinta(){
      nos.forEach(function(no,k){
        no.classList.toggle('feito', k<i);
        no.classList.toggle('ativo', k===i);
        no.classList.toggle('parado', estado==='hoje' && k===i && travaEm(k));
        /* tudo que vem depois do vão fica apagado: o processo não chegou lá.
           Marcado por classe, não por seletor irmão — as fases são listas
           separadas, então `~` não alcança a fase seguinte. */
        no.classList.toggle('apos', estado==='hoje' && travaEm(i) && k>i);
      });
      if(typeof tocaAtivo==='function') tocaAtivo();
      if(!log) return;
      if(i<0){ log.textContent=''; return; }
      var no=nos[i];
      var titulo=no.querySelector('strong').textContent;
      var detalhe=no.querySelector(estado==='hoje'?'.fx-hoje':'.fx-vos').textContent;
      log.textContent = estado==='hoje' && travaEm(i)
        ? titulo+' — parou aqui: '+detalhe
        : titulo+' — '+detalhe;
    }

    /* Só o cartão ativo toca. Nove vídeos em laço ao mesmo tempo seria uma
       parede de movimento — e é a mesma regra que já vale pro resto da cena.
       Com "menos movimento" nenhum toca: fica o poster. */
    var videos=[].slice.call(raiz.querySelectorAll('.cn-video'));
    /* Marca a raiz assim que HOUVER quadro para mostrar. Antes eu escutava só
       'loadeddata' e ele não disparava com preload="metadata" — resultado: o
       desenho continuava visível POR BAIXO do vídeo transparente, os dois na
       tela ao mesmo tempo. Agora escuta os dois eventos e ainda confere o
       readyState na hora, para o caso de já ter carregado. */
    function marcaVideo(){ raiz.classList.add('com-video'); }
    videos.forEach(function(v){
      if(v.readyState>=2) marcaVideo();
      v.addEventListener('loadeddata', marcaVideo, {once:true});
      v.addEventListener('playing',    marcaVideo, {once:true});
    });

    function tocaAtivo(){
      videos.forEach(function(v,k){
        var deve = !reduz && estado==='hoje' && k===i;
        if(deve){ if(v.paused){ v.currentTime=0; var p=v.play(); if(p&&p.catch) p.catch(function(){}); } }
        else if(!v.paused){ v.pause(); }
      });
    }

    function passo(){ if(i<nos.length-1){ i++; pinta(); if(i===2) rodaRelogio(); } }
    function reinicia(){ i=-1; pinta(); clearTimeout(tRel);
      relogios.forEach(function(el){ el.textContent=reduz?el.dataset.fim:'0 s'; }); }

    function passada(){
      clearTimeout(t);
      /* silencia o leitor de tela durante a passada automática: 12 anúncios
         em 5s é ruído, não informação. Volta a anunciar quando a cadeia para. */
      if(log) log.setAttribute('aria-live','off');
      if(reduz){ i=nos.length-1; pinta(); paraRelogio(); return; }
      reinicia();
      (function anda(){
        if(i>=nos.length-1) return;
        t=setTimeout(function(){
          passo();
          /* no estado "hoje" a cadeia PARA no vão e só anda se alguém empurrar
             — que é literalmente a tese da seção. No "vos" ela segue sozinha. */
          if(travaEm(i) || i>=nos.length-1){ if(log) log.setAttribute('aria-live','polite'); return; }
          anda();
        }, 400);
      })();
    }

    abas.forEach(function(b){
      b.addEventListener('click',function(){
        estado=b.dataset.estado;
        raiz.dataset.estado=estado;
        abas.forEach(function(o){ o.setAttribute('aria-pressed', String(o===b)); });
        passada();
      });
    });

    /* clique OU teclado avançam um passo — o ritmo é do usuário. O teclado
       não era alcançável até a 3ª revisão apontar: o comentário prometia e o
       código não entregava. */
    var grade=raiz.querySelector('.fluxo-grade');
    grade.addEventListener('keydown',function(ev){
      if(ev.key==='Enter'||ev.key===' '){ ev.preventDefault(); grade.click(); }
    });
    grade.addEventListener('click',function(){
      clearTimeout(t);
      if(i>=nos.length-1){ reinicia(); return; }
      passo();
      /* com "menos movimento" o clique salta direto pro fim: nada de
         encadear timers, que era o furo da 3ª revisão. */
      if(reduz){ i=nos.length-1; pinta(); return; }
      /* destravou: volta a correr até o próximo vão */
      if(!travaEm(i)) (function anda(){
        if(i>=nos.length-1) return;
        t=setTimeout(function(){ passo(); if(travaEm(i)) return; anda(); }, 400);
      })();
    });

    if('IntersectionObserver' in window){
      var io=new IntersectionObserver(function(es){
        es.forEach(function(e){ if(e.isIntersecting){ passada(); io.unobserve(e.target); } });
      },{threshold:.3});
      io.observe(raiz);
    } else { i=nos.length-1; pinta(); paraRelogio(); }
  })();


  /* ── WhatsApp flutuante ────────────────────────────────────────────────
     Monta o link na hora do clique para carregar um `event_id` novo a cada
     vez, e empurra `clique_whatsapp` no dataLayer com os identificadores do
     primeiro toque. O GTM ainda NÃO consome este evento — standby pedido pelo
     Orlando em 19/08. Quando consumir, o event_id daqui é o mesmo que vai no
     texto da conversa, e é por ele que a conversão do WhatsApp se casa com a
     sessão do site (e sustenta o EMQ na Meta). */
  (function(){
    var a=document.getElementById('zap'); if(!a) return;
    var NUM='5543996885300';

    function primeiroToque(){
      var out={};
      try{
        var m=document.cookie.match('(?:^|; )vos_ft=([^;]*)');
        if(!m) return out;
        var ft=JSON.parse(decodeURIComponent(m[1]));
        ['fbp','fbc','fbclid','gclid'].forEach(function(k){ if(ft[k]) out[k]=ft[k]; });
        if(ft.clientId) out.client_id=ft.clientId;
        if(ft.stapeUserId) out.stape_user_id=ft.stapeUserId;
      }catch(e){}
      return out;
    }

    function novoId(){
      try{ if(crypto&&crypto.randomUUID) return crypto.randomUUID().slice(0,8); }catch(e){}
      return (Date.now().toString(36)+Math.random().toString(36).slice(2,6));
    }

    /* o balao entra uma vez por sessao, depois do hero */
    var balao=document.getElementById('zapBalao');
    var fechar=document.getElementById('zapX');
    var CHAVE='vos_zap_dispensado';
    var jaFoi=false;
    function mostraBalao(){
      if(jaFoi||!balao) return;
      try{ if(sessionStorage.getItem(CHAVE)) return; }catch(e){}
      jaFoi=true; balao.hidden=false;
      requestAnimationFrame(function(){ balao.classList.add('in'); });
    }
    if(fechar) fechar.addEventListener('click',function(){
      balao.classList.remove('in');
      setTimeout(function(){ balao.hidden=true; }, 240);
      try{ sessionStorage.setItem(CHAVE,'1'); }catch(e){}
    });
    (function(){
      var disparou=false;
      function confere(){
        if(disparou||scrollY<520) return;
        disparou=true; window.removeEventListener('scroll',confere);
        setTimeout(mostraBalao, 1400);
      }
      window.addEventListener('scroll',confere,{passive:true});
      confere();
    })();

    a.addEventListener('click',function(){
      var id=novoId();
      var texto='Oi! Vim pelo site do VOS e quero entender como funciona. (ref '+id+')';
      a.href='https://wa.me/'+NUM+'?text='+encodeURIComponent(texto);
      var dados=primeiroToque();
      dados.event='clique_whatsapp';
      dados.event_id=id;
      window.dataLayer=window.dataLayer||[];
      window.dataLayer.push(dados);
    });
  })();

  /* player: toca sozinho (mudo) quando entra na tela e pausa quando sai.
     Autoplay com som é bloqueado em todo navegador, então o som fica a um
     toque de distância no chip. Capa e clique seguem valendo como caminho
     manual — inclusive quando o autoplay é recusado. */
  (function(){
    var pl=document.getElementById('player'), vid=document.getElementById('vid'),
        capa=document.getElementById('capa'), som=document.getElementById('som');
    if(!pl||!vid||!capa) return;
    var comSom=false;

    function ligaSom(){
      comSom=true; vid.muted=false; vid.controls=true;
      pl.classList.add('on','audio');
      vid.play();
    }
    capa.addEventListener('click',ligaSom);
    if(som) som.addEventListener('click',ligaSom);

    var reduz=matchMedia('(prefers-reduced-motion: reduce)').matches;
    if(!reduz && 'IntersectionObserver' in window){
      var dentro=false;
      function tenta(){
        if(!dentro) return;
        if(!comSom) vid.muted=true;
        var p=vid.play();
        // só some com a capa se o navegador REALMENTE deixou tocar
        if(p&&p.then) p.then(function(){pl.classList.add('on');}).catch(function(){});
      }
      // quem cai na página com o player já na tela (scroll restaurado, voltar
      // do histórico) pede play antes de ter mídia: o canplay tenta de novo
      vid.addEventListener('canplay',tenta);
      new IntersectionObserver(function(es){
        es.forEach(function(e){
          dentro=e.isIntersecting;
          if(dentro) tenta();
          else if(!vid.paused) vid.pause();
        });
      },{threshold:.55}).observe(pl);
    }

    // no fim volta a capa, e o próximo play recomeça mudo
    vid.addEventListener('ended',function(){
      pl.classList.remove('on','audio'); vid.controls=false; comSom=false;
    });
  })();

  /* barra fixa: entra depois do primeiro scroll e SAI quando o CTA de verdade
     (o do fim da faixa) está na tela, senão a página termina com dois botões
     laranja idênticos empilhados */
  (function(){
    var bar=document.getElementById('bar'), fim=document.querySelector('.band-cta');
    function atualiza(){
      var naTela=false;
      if(fim){ var r=fim.getBoundingClientRect(); naTela = r.top < innerHeight-40 && r.bottom > 0; }
      bar.classList.toggle('show', scrollY>480 && !naTela);
    }
    /* getBoundingClientRect a cada scroll força layout; coalesce num rAF */
    var raf=0;
    function agenda(){ if(raf) return; raf=requestAnimationFrame(function(){ raf=0; atualiza(); }); }
    addEventListener('scroll',agenda,{passive:true});
    addEventListener('resize',agenda,{passive:true});
    atualiza();
  })();

</script>

<LeadWizardModal client:load />

<script is:inline>
  /* CTA -> modal de lead (mesmo contrato da home: [data-action='lead']).
     __vosLeadPending cobre o clique que chega ANTES da ilha hidratar (4G):
     a modal consome a flag no mount e abre sozinha — nenhum toque no CTA
     principal pode se perder em silêncio. */
  document.addEventListener("click", function (e) {
    var el = e.target instanceof Element ? e.target.closest("[data-action='lead']") : null;
    if (!el) return;
    e.preventDefault();
    window.__vosLeadPending = true;
    window.dispatchEvent(new CustomEvent("vos:open-lead"));
  });
</script>

