---
// Rota /lp · landing de campanha (anúncios). Documento próprio: o HTML, o CSS
// e o JS vêm do repo vertex-lp e ficam intactos (`is:inline`), sem o chrome
// da home (Nav/Footer/tema). O que é compartilhado com o resto do site:
//   · GTM + primeiro toque (vos_ft)                     -> GtmHead/GtmNoScript/FirstTouch
//   · CTA -> mesma modal de lead (2 etapas) -> Cal.com  -> <LeadWizardModal/>
// Os CTAs têm data-action="lead"; o listener no fim do body dispara o evento
// "vos:open-lead", exatamente como na home.
import "../styles/lp.css";
import GtmHead from "../components/tracking/GtmHead.astro";
import GtmNoScript from "../components/tracking/GtmNoScript.astro";
import FirstTouch from "../components/tracking/FirstTouch.astro";
import LeadWizardModal from "../components/islands/LeadWizardModal.tsx";

const title = "VOS · A maneira mais fácil de atender, vender e gerenciar seu negócio";
const description =
  "O VOS transforma conversas em vendas e conecta agenda, estoque, operação e financeiro no mesmo fluxo. Agende uma demonstração de 15 minutos.";
// Domínio REAL do site (o `site` do astro.config aponta pra osvertex.com, que
// hoje devolve 404 — canonical/og apontando pra lá quebrariam preview e SEO).
const SITE_URL = "https://www.voshq.com";
const url = `${SITE_URL}/lp`;
const ogImage = `${SITE_URL}/og.png`;
---

<!doctype html>
<html lang="pt-BR">
<head>
  <GtmHead />
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<!-- Mesma marca do app (apps/web/app/icon.png), pra aba e atalho baterem com o produto -->
<link rel="icon" type="image/png" sizes="32x32" href="/lp/favicon.png">
<link rel="icon" type="image/png" sizes="192x192" href="/lp/icon-192.png">
<link rel="icon" type="image/png" sizes="512x512" href="/lp/icon-512.png">
<link rel="apple-touch-icon" href="/lp/apple-touch-icon.png">
<meta name="theme-color" content="#0d0d0d">
<meta name="description" content="A maneira mais fácil de atender, vender e gerenciar seu negócio em um só lugar. O VOS transforma conversas em vendas e conecta agenda, estoque, operação e financeiro no mesmo fluxo.">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<!-- Tipografia oficial do VOS: Inter em TUDO (DS §4/§18). A voz manuscrita da
     campanha é fonte de sistema e não passa por aqui. -->
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <!-- Fontes da modal de lead (Geist/Jakarta/JetBrains Mono), pro wizard ficar
       igual ao do resto do site. A LP em si é Inter. -->
  <link
    href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
    rel="stylesheet"
  />
  <title>{title}</title>
  <link rel="canonical" href={url} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={url} />
  <meta property="og:locale" content="pt_BR" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
</head>
<body>
<GtmNoScript />

<div class="wrap">
  <div class="hdr">
    <div class="logo">
      <img src="/lp/vos-logo-mono-dark.png" alt="VOS" width="901" height="277">
    </div>
  </div>

  <section class="hero">
    <div class="eb"><u>A nova era do seu negócio<svg viewBox="0 0 240 10" preserveAspectRatio="none"><path d="M2 7.4C46 3.1 120 1.9 178 3.4c22 .6 46 1.9 60 3.6"/></svg></u></div>
    <h1>A maneira mais fácil de
      <span class="stk">
        <span class="stk-word"><i>atender</i><i>vender</i><i>gerenciar</i></span>
      </span>
      seu negócio em um só lugar.</h1>
    <p class="lead">O VOS transforma conversas em vendas e conecta agenda, estoque, operação e financeiro no mesmo fluxo.</p>
    <a href="#agendar" class="cta" data-action="lead">Agendar demonstração<svg class="ar" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    <p class="atrito">15 minutos, sem cartão e sem instalar nada. Você sai da call com o atendimento do seu negócio já desenhado.</p>
    <div class="badges">
      <div class="proof">
        <div class="pf">
          <svg class="pf-meta" viewBox="0 0 36 20" fill="none" stroke="currentColor"
               stroke-width="2.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 10c2.6-4.6 4.9-6.6 7.6-6.6 3.4 0 5.9 3 5.9 6.6s-2.5 6.6-5.9 6.6c-2.7 0-5-2-7.6-6.6-2.6-4.6-4.9-6.6-7.6-6.6C7 3.4 4.5 6.4 4.5 10s2.5 6.6 5.9 6.6c2.7 0 5-2 7.6-6.6Z"/>
          </svg>
          <span class="pf-txt"><b>Meta</b> Business Partner</span>
        </div>

        <span class="pf-sep" aria-hidden="true"></span>

        <div class="pf">
          <img class="pf-logo" src="/lp/vos-logo-mono-dark.png" alt="VOS" width="901" height="277">
        </div>
      </div>
      <div class="integr">
        <div class="ics">
          <span class="ic" style="border-color:#25D366" title="WhatsApp"><svg viewBox="0 0 24 24" fill="#25D366"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm5.7 14.1c-.2.7-1.4 1.4-2 1.4-.5 0-1.1.2-3.7-.8-3.1-1.3-5-4.4-5.2-4.6-.1-.2-1.2-1.5-1.2-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.3.4-.4.5c-.1.1-.3.3-.1.6a9 9 0 0 0 1.5 1.8 8 8 0 0 0 2.1 1.3c.3.1.4.1.6-.1l.8-1c.2-.2.3-.2.6-.1l1.8.9c.3.1.4.2.5.3.1.2.1.7-.1 1.4Z"/></svg></span>
          <span class="ic" style="border-color:#D6249F" title="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="#D6249F" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5.4"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1.2" fill="#D6249F" stroke="none"/></svg></span>
          <span class="ic" style="border-color:#0084FF" title="Messenger"><svg viewBox="0 0 24 24" fill="#0084FF"><path d="M12 2C6.3 2 2 6.2 2 11.7c0 3.1 1.4 5.9 3.7 7.7v3.1l3.4-1.9c.9.3 1.9.4 2.9.4 5.7 0 10-4.2 10-9.7S17.7 2 12 2Zm1 13-2.6-2.7L5.6 15l5.3-5.6 2.6 2.7L18.3 9 13 15Z"/></svg></span>
          <span class="ic" style="border-color:#0866FF" title="Meta"><svg viewBox="0 0 24 24" fill="none" stroke="#0866FF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.6 14.3c0-3.6 1.8-6.6 4-6.6 1.3 0 2.3 1 3.5 2.9 1.4 2.2 2.3 3.6 2.3 3.6 1.4 2.2 2.1 2.9 3.2 2.9 1.4 0 2.5-1.3 2.5-3.4 0-2.4-1.1-4.9-2.9-4.9-1 0-2 .7-3.3 2.5"/><path d="M9.5 9.4C8.2 7.6 7.1 6.7 5.9 6.7c-2.4 0-4.3 3.2-4.3 7.2 0 2.1 1 3.5 2.6 3.5 1.2 0 2.1-.6 3.6-2.9"/></svg></span>
          <span class="ic" style="border-color:#111" title="TikTok"><svg viewBox="0 0 24 24" fill="#111"><path d="M16.6 2h-3v13.2a2.6 2.6 0 1 1-2.2-2.6V9.5a5.8 5.8 0 1 0 5.2 5.8V8.9c1.1.8 2.4 1.2 3.8 1.3V7.1a4.3 4.3 0 0 1-3.8-5.1Z"/></svg></span>
          <span class="ic" style="border-color:#29A9EA" title="Telegram"><svg viewBox="0 0 24 24" fill="#29A9EA"><path d="M21.7 3.3 2.9 10.6c-1 .4-1 1.4 0 1.7l4.7 1.5 1.8 5.5c.2.6.4.8 1 .8.5 0 .7-.2 1-.6l2.3-2.2 4.7 3.5c.9.5 1.5.2 1.7-.8l3.1-14.6c.3-1.2-.5-1.8-1.5-1.4ZM8.9 13.3l9.2-5.8-7.7 6.8-.3 3.2-1.2-4.2Z"/></svg></span>
          <span class="ic" style="border-color:#D97757" title="Claude"><svg viewBox="0 0 24 24" fill="none" stroke="#D97757" stroke-width="1.9" stroke-linecap="round"><path d="M12 2.6v18.8M3.4 12h17.2M5.5 5.5l13 13M18.5 5.5l-13 13"/><path d="M8.4 3.6 15.6 20.4M15.6 3.6 8.4 20.4M3.6 8.4l16.8 7.2M3.6 15.6l16.8-7.2" opacity=".55"/></svg></span>
        </div>
        <span class="lb">Integrações oficiais</span>
      </div>
    </div>
  </section>

  <div class="band">
    <svg class="band-top" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 0H1440v80C1040 4 400 4 0 80Z" fill="var(--bg)"/>
    </svg>
    <div class="band-head">
      <div class="eb"><u>feito pra você<svg viewBox="0 0 240 10" preserveAspectRatio="none"><path d="M2 7.4C46 3.1 120 1.9 178 3.4c22 .6 46 1.9 60 3.6"/></svg></u></div>
      <h2>Inteligência artificial que possui o <u>conhecimento real da sua empresa</u></h2>
    </div>

    <!-- Três provas vivas no lugar do dashboard: a conversa, o funil e a
         operação. Portadas do bento da /v4 (FeaturesBento4 + FunnelLive +
         GestaoLive) pra HTML puro e re-pintadas nos tokens da LP: preto quase
         absoluto + laranja. Cor de ESTÁGIO e de STATUS o DS preserva, então o
         funil mantém os quatro tons e os selos mantêm verde/azul/âmbar. -->
    <div class="feats" id="feats">
      <div class="feats-track" id="featsTrack">

        <article class="feat">
          <div class="feat-eb"><u>como funciona o fluxo<svg viewBox="0 0 240 10" preserveAspectRatio="none"><path d="M2 7.4C46 3.1 120 1.9 178 3.4c22 .6 46 1.9 60 3.6"/></svg></u></div>
          <h3>O fluxo trabalha enquanto você dorme.</h3>
          <p class="feat-sub">Monte uma vez e ele roda sozinho: recebe o lead, responde, agenda e lança no funil.</p>
          <div class="flow" id="flow" aria-hidden="true">
            <div class="flow-tabs" id="flowTabs"></div>
            <div class="flow-canvas" id="flowCanvas"></div>
            <div class="flow-log" id="flowLog"></div>
          </div>
          <p class="feat-note"><i class="feat-dot"></i>Fluxos prontos, ou monte o seu sem programar</p>
        </article>

        <article class="feat">
          <h3>O time todo numa inbox só.</h3>
          <p class="feat-sub">WhatsApp, Instagram, Telegram, Messenger e e-mail na mesma caixa. Nada fica preso no celular de uma pessoa.</p>
          <div class="feat-chat" aria-hidden="true">
            <div class="feat-chat-vp">
              <div class="feat-chat-track" id="chatTrack"></div>
            </div>
          </div>
          <p class="feat-note"><i class="feat-dot"></i>Inbox ao vivo · respondido em 40s</p>
        </article>

        <article class="feat">
          <div class="feat-eb"><u>venda feita, e agora?<svg viewBox="0 0 240 10" preserveAspectRatio="none"><path d="M2 7.4C46 3.1 120 1.9 178 3.4c22 .6 46 1.9 60 3.6"/></svg></u></div>
          <h3>O caixa sobe a cada conversa.</h3>
          <p class="feat-sub">Toda venda que nasce numa conversa cai no caixa na hora, sem ninguém lançar nada.</p>
          <div class="caixa" aria-hidden="true">
            <span class="caixa-lb">Entrou hoje</span>
            <b class="caixa-n" id="caixaN">R$ 3.899</b>
            <div class="caixa-barras" id="caixaBarras"></div>
            <div class="caixa-feed" id="caixaFeed"></div>
          </div>
          <p class="feat-note"><i class="feat-dot"></i>Consulta, produto e sinal caindo no mesmo caixa</p>
        </article>

      </div>
      <!-- setas entre os cards: só no desktop, onde os três ficam lado a lado.
           Posicionadas por JS a partir do retângulo real de cada card. -->
      <span class="feats-seta" aria-hidden="true"><svg viewBox="0 0 40 18"><path d="M2 9c8-3.4 19-3.4 33 0"/><path d="M27.5 3.6 35.5 9 27.5 14.4"/></svg></span>
      <span class="feats-seta" aria-hidden="true"><svg viewBox="0 0 40 18"><path d="M2 9c8-3.4 19-3.4 33 0"/><path d="M27.5 3.6 35.5 9 27.5 14.4"/></svg></span>
      <div class="feats-dots" id="featsDots"></div>
      <div class="feats-dica" id="featsDica">
        <u>arrasta pro lado</u>
        <svg viewBox="0 0 44 16" aria-hidden="true"><path d="M2 8h34M29 2.5 37.5 8 29 13.5"/></svg>
      </div>
    </div>

    <div class="band-head band-head-2">
      <div class="eb"><u>Conheça o VOS<svg viewBox="0 0 240 10" preserveAspectRatio="none"><path d="M2 7.4C46 3.1 120 1.9 178 3.4c22 .6 46 1.9 60 3.6"/></svg></u></div>
      <p>Conecta atendimento, automações, vendas, notas fiscais e a gestão inteira em um único lugar.</p>
    </div>

    <div class="band-video">
      <div class="player" id="player">
        <video id="vid" src="/lp/broll.mp4#t=0.5" poster="/lp/broll-poster.jpg"
               playsinline muted preload="metadata" controlslist="nodownload"></video>
        <button type="button" class="capa" id="capa" aria-label="Assistir ao vídeo">
          <span class="play"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.2v13.6L19 12 8 5.2Z"/></svg></span>
          <span class="rot">Conheça o VOS</span>
        </button>
        <button type="button" class="som" id="som" aria-label="Ativar o som do vídeo">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5Z"/><path d="M22 9l-6 6M16 9l6 6"/></svg>
          Ativar Som
        </button>
      </div>
    </div>

    <div class="band-head band-head-2">
      <div class="eb"><u>não é a gente falando<svg viewBox="0 0 240 10" preserveAspectRatio="none"><path d="M2 7.4C46 3.1 120 1.9 178 3.4c22 .6 46 1.9 60 3.6"/></svg></u></div>
    </div>
    <!-- Esteira de depoimentos: 3 pistas subindo em velocidades diferentes.
         CONTEÚDO É RASCUNHO. Trocar pelos depoimentos reais no array
         DEPOIMENTOS lá embaixo (frase, nome, negócio e cidade). -->
    <div class="depos" id="depos" aria-hidden="true"></div>

    <div class="band-cta"><a href="#agendar" class="cta" data-action="lead">Agendar demonstração<svg class="ar" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></div>
  </div>

</div>

<footer class="lp-foot">
  <span>© 2026 VOS · Vertex Growth Gestão Empresarial LTDA · CNPJ 67.779.810/0001-69</span>
  <a href="/privacidade" target="_blank" rel="noopener">Política de Privacidade</a>
</footer>

<div class="bar" id="bar"><a href="#agendar" class="cta" data-action="lead">Agendar demonstração<svg class="ar" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></div>

<script is:inline>


  /* ── Três provas vivas ──────────────────────────────────────────────────
     Tudo aqui pausa quando a seção sai da tela: são três animações mais o
     vídeo, e isso roda em celular no 4G. */
  (function(){
    var reduz=matchMedia('(prefers-reduced-motion: reduce)').matches;
    var timers=[];
    function cada(ms,fn){ timers.push({ms:ms,fn:fn,id:null}); }

    /* 1 · inbox: a sequência é escrita duas vezes e o trilho anda -50%,
       então o loop emenda sem salto */
    (function(){
      var alvo=document.getElementById('chatTrack'); if(!alvo) return;
      var CONVERSA=[
        ['sep','Ana Prado · WhatsApp'],
        ['in','Oi, vocês atendem amanhã? Quanto fica a limpeza de pele?','22:47'],
        ['out','Boa noite! Atendemos sim. A limpeza fica R$ 180 e amanhã eu tenho 14h ou 16h30.','22:47'],
        ['in','16h30','22:48'],
        ['out','Fechado, agendei pra amanhã às 16h30 com a Camila.','22:48'],
        ['pay','Sinal da sessão · R$ 90','Pagar com PIX'],
        ['in','Paguei!','22:51'],
        ['out','PIX confirmado. Te mando um lembrete amanhã de manhã.','22:51'],
        ['sep','Marina Costa · Instagram'],
        ['in','Ainda tem o sérum de vitamina C?','23:04'],
        ['out','Tem 2 unidades. Quer que eu reserve pra você?','23:05'],
        ['in','Reserva! Pego amanhã.','23:05'],
        ['out','Reservado por 24h. Emito a nota no seu CPF na retirada.','23:06'],
        ['sep','Bruno Salles · Telegram'],
        ['in','Vocês fazem pacote de 4 sessões?','23:19'],
        ['out','Fazemos! Sai R$ 620 e posso já deixar as 4 datas na agenda.','23:20'],
        ['sep','contato@ · E-mail'],
        ['in','Preciso do orçamento em PDF pro RH aprovar.','23:31'],
        ['out','Enviei o PDF agora. Assim que aprovarem, a agenda já abre.','23:33']
      ];
      function esc(s){ return s.replace(/&/g,'&amp;').replace(/</g,'&lt;'); }
      var seq=CONVERSA.map(function(m){
        if(m[0]==='sep') return '<div class="ch-sep"><span>'+esc(m[1])+'</span></div>';
        if(m[0]==='pay') return '<div class="ch-pay"><span>'+esc(m[1])+'</span><b>'+esc(m[2])+'</b></div>';
        return '<div class="ch '+m[0]+'"><p>'+esc(m[1])+'</p><em>'+esc(m[2])+'</em></div>';
      }).join('');
      alvo.innerHTML='<div class="feat-chat-seq">'+seq+'</div><div class="feat-chat-seq">'+seq+'</div>';
    })();


    /* 3 · o caixa: cada entrada nova sobe o número, cresce a barra de hoje e
       entra no feed. Os três movimentos acontecem no mesmo tick de propósito:
       é a mesma venda sendo contada, não três animações soltas. */
    (function(){
      var alvoN=document.getElementById('caixaN'), barras=document.getElementById('caixaBarras'),
          feed=document.getElementById('caixaFeed');
      if(!alvoN||!barras||!feed) return;

      // mesma clínica, mesmas pessoas dos outros dois cards
      var ENTRADAS=[
        [180,'Ana Prado · limpeza de pele'],
        [149,'Marina Costa · sérum vitamina C'],
        [90,'Ana Prado · sinal da sessão'],
        [420,'Pacote de 4 sessões · aprovado'],
        [180,'Retorno da Ana · reagendou'],
        [149,'Marina Costa · segunda unidade']
      ];
      var SEMANA=[52,64,41,58,73,60], hoje=38, teto=100, total=3899, i=0;

      function moeda(v){ return 'R$ ' + v.toLocaleString('pt-BR'); }
      function pintaBarras(){
        barras.innerHTML = SEMANA.map(function(h){ return '<i style="height:'+h+'%"></i>'; }).join('') +
          '<i class="hoje" style="height:'+Math.min(100,hoje)+'%"></i>';
      }
      pintaBarras();
      alvoN.textContent = moeda(total);

      // conta de um valor pro outro em vez de trocar seco: o pulo é o ponto
      function conta(de,ate){
        var t0=null, dur=620;
        function passo(ts){
          if(t0===null) t0=ts;
          var p=Math.min(1,(ts-t0)/dur), e=1-Math.pow(1-p,3);
          alvoN.textContent = moeda(Math.round(de+(ate-de)*e));
          if(p<1) requestAnimationFrame(passo);
        }
        requestAnimationFrame(passo);
      }

      cada(2800,function(){
        var e=ENTRADAS[i%ENTRADAS.length]; i++;
        var antes=total; total+=e[0];
        conta(antes,total);
        alvoN.classList.remove('pulou'); void alvoN.offsetWidth; alvoN.classList.add('pulou');

        hoje=Math.min(teto, hoje + e[0]/28);
        var barraHoje=barras.querySelector('.hoje');
        if(barraHoje) barraHoje.style.height=Math.min(100,hoje)+'%';

        feed.insertAdjacentHTML('afterbegin',
          '<div class="ent"><b>+'+moeda(e[0])+'</b><span>'+e[1]+'</span></div>');
        while(feed.children.length>3) feed.removeChild(feed.lastChild);

        if(hoje>=teto){ hoje=38; if(barraHoje) barraHoje.style.height='38%'; total=3899; }
      });
    })();

    /* 4 · fluxo: o nó acende, o fio preenche e o log conta o que aconteceu.
       Terminado o fluxo, ele troca sozinho pro próximo; clicar na aba escolhe. */
    (function(){
      var abas=document.getElementById('flowTabs'), tela=document.getElementById('flowCanvas'),
          log=document.getElementById('flowLog');
      if(!abas||!tela||!log) return;
      // os três fluxos são a MESMA cliente em três momentos: chega, é lembrada
      // e volta. É o que amarra este card aos outros três.
      var FLUXOS=[
        {nome:'Lead novo', cor:'var(--accent)',
         nos:[['▶','Início','Lead no WhatsApp'],['✦','IA','Lê e qualifica'],
              ['💬','Agenda','Oferece horário'],['✓','CRM','Entra no funil']],
         passos:['Gatilho · Ana Prado chamou às 22:47',
                 'IA leu: limpeza de pele, primeira vez',
                 'Ofereceu 14h ou 16h30 · Ana escolheu 16h30',
                 'Agendada e lançada no funil · sinal de R$ 90 pago']},
        {nome:'Lembrete', cor:'var(--info)',
         nos:[['▶','Início','24h antes'],['💬','Mensagem','Pede confirmação'],
              ['◷','Espera','Resposta'],['✓','Agenda','Dia confirmado']],
         passos:['Gatilho · consulta da Ana amanhã às 16:30',
                 'Enviou a confirmação no WhatsApp',
                 'Ana respondeu: confirmado',
                 'Agenda fechada · nenhum buraco no dia']},
        {nome:'Retorno', cor:'var(--ai)',
         nos:[['▶','Início','Sessão concluída'],['◷','Espera','30 dias'],
              ['💬','Mensagem','Convida pro retorno'],['✓','Venda','Reagendou']],
         passos:['Gatilho · limpeza da Ana concluída',
                 'Esperou 30 dias sem contato',
                 'Convidou pro retorno com horário sugerido',
                 'Ana reagendou · R$ 180 de volta no caixa']}
      ];
      var f=0, passo=-1, id=null;
      FLUXOS.forEach(function(fl,k){
        var b=document.createElement('button');
        b.type='button'; b.className='flow-tab'; b.style.setProperty('--fc',fl.cor);
        b.setAttribute('aria-selected', k===0?'true':'false');
        b.innerHTML='<i></i>'+fl.nome;
        b.addEventListener('click',function(){ escolhe(k); });
        abas.appendChild(b);
      });
      function desenha(){
        var fl=FLUXOS[f];
        tela.style.setProperty('--fc',fl.cor); log.style.setProperty('--fc',fl.cor);
        tela.innerHTML=fl.nos.map(function(n,i){
          return '<div class="fn-wrap">'+(i?'<span class="fn-wire" data-w="'+i+'"></span>':'')+
            '<div class="fn" data-n="'+i+'"><span class="fn-ic">'+n[0]+'</span>'+
            '<div><strong>'+n[1]+'</strong><em>'+n[2]+'</em></div></div></div>';
        }).join('');
        [].slice.call(abas.children).forEach(function(b,k){
          b.setAttribute('aria-selected', k===f?'true':'false');
        });
        pinta();
      }
      function pinta(){
        var fl=FLUXOS[f];
        [].slice.call(tela.querySelectorAll('.fn')).forEach(function(el,i){
          el.classList.toggle('ativo', i===passo);
          el.classList.toggle('feito', i<passo);
        });
        [].slice.call(tela.querySelectorAll('.fn-wire')).forEach(function(el,i){
          el.classList.toggle('on', i<passo);
        });
        log.innerHTML = passo<0 ? '<b>Pronto pra rodar.</b>' : '<b>'+(passo+1)+'/4</b> '+fl.passos[passo];
      }
      function escolhe(k){ f=k; passo=-1; desenha(); }
      desenha();
      cada(1500,function(){
        passo++;
        if(passo>=FLUXOS[f].nos.length+1){ f=(f+1)%FLUXOS.length; passo=-1; desenha(); return; }
        if(passo<FLUXOS[f].nos.length) pinta();
      });
    })();

    /* esteira de depoimentos: 3 pistas subindo. A fita é escrita duas vezes e
       anda -50%, então o loop emenda sem salto. */
    (function(){
      var caixa=document.getElementById('depos'); if(!caixa) return;

      /* Clientes, mesma base da /v4 (src/data/content.ts) e as mesmas fotos.
         [arquivo, nome, negócio, cidade, nota, frase] */
      var DEPOIMENTOS=[
        ['social-16','Tiago Moraes','Oficina Forte','Belo Horizonte, MG','4,8','Fechei o mês com +R$ 32 mil organizando peça, serviço e nota num lugar só. Antes eram três sistemas e uma planilha.'],
        ['social-17','Vanessa Lopes','Supermercado Bom Dia','Curitiba, PR','4,7','Parei de perder venda por falta de controle. O estoque bate com o caixa todo dia, sem conferência no domingo.'],
        ['social-18','Fernando Reis','Engefort Engenharia','São Paulo, SP','4,6','Orçamento vira OS, a equipe vê no celular e o cliente acompanha. Obra atrasada por falta de informação acabou.'],
        ['social-19','Carla Mendes','Café Aroma','Porto Alegre, RS','4,5','O fluxo de caixa atualiza sozinho a cada venda. Sei exatamente quanto entra e sai antes de fechar o dia.'],
        ['social-20','Diego Prado','Prime Elétrica','Recife, PE','4,8','Migrei num fim de semana. Segunda já estava vendendo dentro do VOS e o time não precisou de treinamento longo.'],
        ['social-12','Patrícia Nunes','Ello Calçados','Fortaleza, CE','4,7','Catálogo no WhatsApp, pedido automático e estoque baixando sozinho. Vende mais sem contratar ninguém.'],
        ['social-21','Aline Costa','Adega Premium','Rio de Janeiro, RJ','4,6','Pedido, PIX e notificação pro estoque, tudo no automático. O cliente compra de madrugada e eu acordo com tudo organizado.'],
        ['social-11','Eduardo Pires','Construla Obras','Brasília, DF','4,8','Orçamento aceito vira OS na hora. Cliente assina digital e a obra já entra na agenda da equipe.'],
        ['social-22','Marcos Vieira','Alfa Climatização','Campinas, SP','4,7','A equipe sai pra rua com tudo no celular. Resposta na hora e nada se perde no caminho entre visita e escritório.'],
        ['social-14','Sandra Moraes','Empório Sabor','Salvador, BA','4,5','NF-e sai junto com a venda. Fim de mês sem correria com contador por nota que faltou emitir.'],
        ['social-23','Letícia Ramos','Agro Campo Verde','Goiânia, GO','4,6','Proposta, contrato e cobrança no mesmo fluxo. Parei de digitar os mesmos dados em três lugares diferentes.'],
        ['social-13','Renato Alves','Auto Peças Brasil','Manaus, AM','4,8','Alerta de estoque baixo antes de faltar peça. Cliente não vai embora porque o sistema avisou a tempo.'],
        ['social-24','Rodrigo Santos','Alta Fitness','Florianópolis, SC','4,7','Confirmação automática no WhatsApp reduziu faltas. A agenda enche e o time sabe quem vem antes de abrir a academia.'],
        ['social-25','Juliana Reis','Studio Bella','Belém, PA','4,8','As faltas caíram demais com a confirmação automática. A agenda vive lotada e o salão não fica com horário vazio.'],
        ['social-15','André Andrade','Andrade Contabilidade','São Paulo, SP','4,6','Tudo num lugar só. O time parou de digitar a mesma coisa em três sistemas e os clientes sentem a diferença.']
      ];
      var ehRascunho = false;

      function cartao(d){
        return '<div class="depo"><div class="depo-estrelas">★★★★★<em>'+d[4]+'</em></div><p>'+d[5]+'</p>'+
          '<div class="depo-quem"><img class="depo-av" src="/lp/pessoas/'+d[0]+'.webp" alt="" loading="lazy" width="56" height="56">'+
          '<span><b>'+d[1]+'</b><span>'+d[2]+' · '+d[3]+'</span></span></div></div>';
      }
      var pistas=innerWidth>=760?3:1, veloc=['38s','46s','42s'];
      function monta(){
        var n=innerWidth>=760?3:1;
        if(n===pistas && caixa.children.length) return;   // só remonta se mudou de faixa
        pistas=n; caixa.innerHTML='';
        for(var p=0;p<n;p++){
          var lista=DEPOIMENTOS.filter(function(_,i){ return n===1 || i%n===p; });
          var fita=lista.map(cartao).join('');
          caixa.insertAdjacentHTML('beforeend',
            '<div class="depo-pista"><div class="depo-fita" style="--v:'+veloc[p]+'">'+fita+fita+'</div></div>');
        }
      }
      monta();
      addEventListener('resize',monta,{passive:true});
      if(ehRascunho){
        caixa.classList.add('rascunho');
        caixa.insertAdjacentHTML('afterend',
          '<p class="depos-aviso">Rascunho: trocar pelos depoimentos reais antes de publicar.</p>');
      }
    })();

    /* carrossel: só no celular. O card fica parado 6s deixando a animação dele
       contar a história, e o dedo do usuário desliga o automático. */
    (function(){
      var trilho=document.getElementById('featsTrack'), pontos=document.getElementById('featsDots');
      if(!trilho||!pontos) return;
      var cards=[].slice.call(trilho.children), atual=0, manual=false;
      var dica=document.getElementById('featsDica');
      function some(){ if(dica) dica.classList.add('foi'); }
      cards.forEach(function(_,k){
        var b=document.createElement('button');
        b.type='button'; b.setAttribute('aria-label','Card '+(k+1));
        b.addEventListener('click',function(){ manual=true; some(); vai(k); });
        pontos.appendChild(b);
      });
      function marca(){
        [].slice.call(pontos.children).forEach(function(b,k){
          b.setAttribute('aria-current', k===atual?'true':'false');
        });
      }
      function vai(k,suave){
        atual=(k+cards.length)%cards.length;
        trilho.scrollTo({left:cards[atual].offsetLeft-trilho.offsetLeft-((trilho.clientWidth-cards[atual].clientWidth)/2),
          behavior:suave===false?'auto':'smooth'});
        marca();
      }
      marca();
      // girar o celular muda a largura do card: sem re-centrar, o carrossel fica
      // parado no meio de dois
      var t=null;
      addEventListener('resize',function(){
        clearTimeout(t); t=setTimeout(function(){ if(innerWidth<900) vai(atual,false); },160);
      },{passive:true});
      /* gesto de verdade, não o scroll: o trilho dispara scroll sozinho no
         ajuste inicial e isso apagava a dica antes de alguém ver */
      ['pointerdown','wheel'].forEach(function(ev){
        trilho.addEventListener(ev,function(){ manual=true; some(); },{passive:true});
      });
      trilho.addEventListener('scroll',function(){
        var meio=trilho.scrollLeft+trilho.clientWidth/2, perto=0, dist=1e9;
        cards.forEach(function(c,k){
          var d=Math.abs(c.offsetLeft+c.clientWidth/2-trilho.offsetLeft-meio);
          if(d<dist){ dist=d; perto=k; }
        });
        if(perto!==atual){ atual=perto; marca(); }
      },{passive:true});
      cada(6000,function(){ if(!manual && innerWidth<900) vai(atual+1); });

      /* as setas se posicionam pelo vão real entre um card e o próximo, então
         acompanham qualquer mudança de largura sem conta de porcentagem */
      var setas=[].slice.call(document.querySelectorAll('.feats-seta'));
      function poeSetas(){
        if(!setas.length || innerWidth<900) return;
        var base=trilho.parentElement.getBoundingClientRect();
        setas.forEach(function(s,k){
          var a=cards[k], b=cards[k+1]; if(!a||!b) return;
          var ra=a.getBoundingClientRect(), rb=b.getBoundingClientRect();
          s.style.left=((ra.right+rb.left)/2 - base.left)+'px';
          s.style.top=(ra.top + ra.height/2 - base.top)+'px';
        });
      }
      /* ResizeObserver, não só o resize da janela: ele dispara no primeiro
         layout, quando a Inter troca a altura do card e em qualquer mudança de
         largura. Só com o resize da janela a seta ficava em left:0 pra quem
         carregasse a página já no desktop. */
      if('ResizeObserver' in window){ new ResizeObserver(poeSetas).observe(trilho); }
      addEventListener('resize',poeSetas,{passive:true});
      poeSetas();
    })();

    /* liga e desliga tudo conforme a seção entra e sai da tela */
    (function(){
      var secao=document.getElementById('feats'); if(!secao||reduz) return;
      function liga(){ timers.forEach(function(t){ if(!t.id) t.id=setInterval(t.fn,t.ms); }); }
      function desliga(){ timers.forEach(function(t){ if(t.id){ clearInterval(t.id); t.id=null; } }); }
      if('IntersectionObserver' in window){
        new IntersectionObserver(function(es){
          es.forEach(function(e){ e.isIntersecting?liga():desliga(); });
        },{threshold:.15}).observe(secao);
      } else { liga(); }
    })();
  })();

  var io=new IntersectionObserver(function(es){es.forEach(function(e){
    if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});},{threshold:.14});
  document.querySelectorAll('.reveal').forEach(function(el){io.observe(el);});

  /* player: toca sozinho (mudo) quando entra na tela e pausa quando sai.
     Autoplay com som é bloqueado em todo navegador, então o som fica a um
     toque de distância no chip. Capa e clique seguem valendo como caminho
     manual — inclusive quando o autoplay é recusado. */
  (function(){
    var pl=document.getElementById('player'), vid=document.getElementById('vid'),
        capa=document.getElementById('capa'), som=document.getElementById('som');
    if(!pl||!vid||!capa) return;
    var comSom=false;

    function ligaSom(){
      comSom=true; vid.muted=false; vid.controls=true;
      pl.classList.add('on','audio');
      vid.play();
    }
    capa.addEventListener('click',ligaSom);
    if(som) som.addEventListener('click',ligaSom);

    var reduz=matchMedia('(prefers-reduced-motion: reduce)').matches;
    if(!reduz && 'IntersectionObserver' in window){
      var dentro=false;
      function tenta(){
        if(!dentro) return;
        if(!comSom) vid.muted=true;
        var p=vid.play();
        // só some com a capa se o navegador REALMENTE deixou tocar
        if(p&&p.then) p.then(function(){pl.classList.add('on');}).catch(function(){});
      }
      // quem cai na página com o player já na tela (scroll restaurado, voltar
      // do histórico) pede play antes de ter mídia: o canplay tenta de novo
      vid.addEventListener('canplay',tenta);
      new IntersectionObserver(function(es){
        es.forEach(function(e){
          dentro=e.isIntersecting;
          if(dentro) tenta();
          else if(!vid.paused) vid.pause();
        });
      },{threshold:.55}).observe(pl);
    }

    // no fim volta a capa, e o próximo play recomeça mudo
    vid.addEventListener('ended',function(){
      pl.classList.remove('on','audio'); vid.controls=false; comSom=false;
    });
  })();

  /* barra fixa: entra depois do primeiro scroll e SAI quando o CTA de verdade
     (o do fim da faixa) está na tela, senão a página termina com dois botões
     laranja idênticos empilhados */
  (function(){
    var bar=document.getElementById('bar'), fim=document.querySelector('.band-cta');
    function atualiza(){
      var naTela=false;
      if(fim){ var r=fim.getBoundingClientRect(); naTela = r.top < innerHeight-40 && r.bottom > 0; }
      bar.classList.toggle('show', scrollY>480 && !naTela);
    }
    /* getBoundingClientRect a cada scroll força layout; coalesce num rAF */
    var raf=0;
    function agenda(){ if(raf) return; raf=requestAnimationFrame(function(){ raf=0; atualiza(); }); }
    addEventListener('scroll',agenda,{passive:true});
    addEventListener('resize',agenda,{passive:true});
    atualiza();
  })();

</script>

<LeadWizardModal client:load />

<script is:inline>
  /* CTA -> modal de lead (mesmo contrato da home: [data-action='lead']).
     __vosLeadPending cobre o clique que chega ANTES da ilha hidratar (4G):
     a modal consome a flag no mount e abre sozinha — nenhum toque no CTA
     principal pode se perder em silêncio. */
  document.addEventListener("click", function (e) {
    var el = e.target instanceof Element ? e.target.closest("[data-action='lead']") : null;
    if (!el) return;
    e.preventDefault();
    window.__vosLeadPending = true;
    window.dispatchEvent(new CustomEvent("vos:open-lead"));
  });
</script>

