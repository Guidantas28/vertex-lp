---
// Página de artigo: prosa + FAQ (AEO) + CTA + relacionados.
// JSON-LD: BlogPosting, FAQPage (se houver faq) e BreadcrumbList.
import { getCollection } from "astro:content";
import BlogShell from "../../layouts/BlogShell.astro";
import { GetStartedButton } from "../../components/ui/get-started-button";
import {
  CATEGORY_META,
  ORG_SCHEMA,
  formatDate,
  readingTime,
  sortPosts,
  postUrl,
} from "../../lib/blog";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const all = sortPosts(await getCollection("blog", ({ data }) => !data.draft));
const related = all
  .filter((p) => p.slug !== post.slug)
  .sort((a, b) => {
    const sameA = a.data.category === post.data.category ? 1 : 0;
    const sameB = b.data.category === post.data.category ? 1 : 0;
    return sameB - sameA;
  })
  .slice(0, 3);

const cat = CATEGORY_META[post.data.category];
const url = `https://www.voshq.com${postUrl(post.slug)}`;
const minutes = readingTime(post.body);

const schema: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "@id": `${url}#article`,
    headline: post.data.title,
    description: post.data.description,
    inLanguage: "pt-BR",
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    author: { "@type": "Organization", name: post.data.author, url: "https://www.voshq.com" },
    publisher: ORG_SCHEMA,
    mainEntityOfPage: { "@type": "WebPage", "@id": url },
    image: "https://www.voshq.com/og.png",
    articleSection: cat?.label ?? post.data.category,
    keywords: post.data.tags.join(", "),
    wordCount: post.body.trim().split(/\s+/).length,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Início", item: "https://www.voshq.com/" },
      { "@type": "ListItem", position: 2, name: "Blog", item: "https://www.voshq.com/blog/" },
      { "@type": "ListItem", position: 3, name: post.data.title, item: url },
    ],
  },
];

if (post.data.faq.length > 0) {
  schema.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: post.data.faq.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  });
}
---

<BlogShell
  title={`${post.data.title} · Blog do VOS`}
  description={post.data.description}
  canonical={url}
  ogType="article"
  {schema}
>
  <article class="post">
    <header class="post-head">
      <div class="zx-container post-narrow">
        <nav class="post-crumbs" aria-label="Você está em">
          <a href="/">Início</a>
          <span aria-hidden="true">/</span>
          <a href="/blog/">Blog</a>
          <span aria-hidden="true">/</span>
          <a href={`/blog/categoria/${post.data.category}/`}>{cat?.label ?? post.data.category}</a>
        </nav>
        <h1>{post.data.title}</h1>
        <p class="post-desc">{post.data.description}</p>
        <p class="blog-meta">
          <span class="blog-chip" style={`--cat: ${cat?.color}`}>{cat?.label}</span>
          &nbsp;·&nbsp; {formatDate(post.data.pubDate)}
          {post.data.updatedDate && ` · atualizado em ${formatDate(post.data.updatedDate)}`}
          &nbsp;·&nbsp; {minutes} min de leitura &nbsp;·&nbsp; {post.data.author}
        </p>
      </div>
    </header>

    <div class="zx-container post-narrow">
      <div class="post-prose">
        <Content />
      </div>

      {post.data.faq.length > 0 && (
        <section class="post-faq" aria-labelledby="faq-title">
          <h2 id="faq-title">Perguntas frequentes</h2>
          {post.data.faq.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </section>
      )}

      <aside class="post-cta">
        <p class="post-cta-kicker">Coloque em prática</p>
        <h2>Tudo isso já vem pronto no VOS</h2>
        <p>
          CRM, WhatsApp, automações, agenda e financeiro em um sistema só — com o
          Zé, a IA que executa por você. Teste na sua empresa.
        </p>
        <GetStartedButton client:visible label="Conhecer o VOS" />
      </aside>

      {related.length > 0 && (
        <section class="post-related" aria-labelledby="rel-title">
          <h2 id="rel-title">Continue lendo</h2>
          <div class="post-related-grid">
            {related.map((p) => (
              <a href={postUrl(p.slug)}>
                <span class="blog-chip" style={`--cat: ${CATEGORY_META[p.data.category]?.color}`}>
                  {CATEGORY_META[p.data.category]?.label}
                </span>
                <strong>{p.data.title}</strong>
                <span class="blog-meta">{formatDate(p.data.pubDate)}</span>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </article>
</BlogShell>

<style is:global>
  .post-narrow {
    max-width: 780px;
  }
  .post-head {
    padding: clamp(48px, 8vh, 80px) 0 8px;
  }
  .post-crumbs {
    display: flex;
    gap: 8px;
    font-size: 13px;
    color: var(--zx-ink3);
    margin-bottom: 22px;
    flex-wrap: wrap;
  }
  .post-crumbs a {
    color: var(--zx-ink3);
    text-decoration: none;
  }
  .post-crumbs a:hover {
    color: var(--zx-ink);
  }
  .post-head h1 {
    font-family: var(--zx-display);
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.12;
    letter-spacing: -0.02em;
    font-weight: 700;
    margin: 0 0 14px;
    text-wrap: balance;
  }
  .post-desc {
    font-size: 18px;
    line-height: 1.6;
    color: var(--zx-ink2);
    margin: 0 0 18px;
  }

  .post-prose {
    padding: 24px 0 8px;
    font-size: 17px;
    line-height: 1.75;
    color: var(--zx-ink);
  }
  .post-prose h2 {
    font-family: var(--zx-display);
    font-size: 26px;
    line-height: 1.25;
    font-weight: 700;
    margin: 44px 0 14px;
    letter-spacing: -0.015em;
  }
  .post-prose h3 {
    font-family: var(--zx-display);
    font-size: 20px;
    font-weight: 700;
    margin: 32px 0 10px;
  }
  .post-prose p {
    margin: 0 0 18px;
  }
  .post-prose ul,
  .post-prose ol {
    margin: 0 0 18px;
    padding-left: 24px;
  }
  .post-prose li {
    margin-bottom: 8px;
  }
  .post-prose a {
    color: var(--zx-lar);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .post-prose strong {
    font-weight: 600;
  }
  .post-prose blockquote {
    margin: 24px 0;
    padding: 4px 0 4px 20px;
    border-left: 3px solid var(--zx-lar);
    color: var(--zx-ink2);
    font-style: italic;
  }
  .post-prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 24px 0;
    font-size: 15px;
    display: block;
    overflow-x: auto;
  }
  .post-prose th,
  .post-prose td {
    border: 1px solid var(--zx-line-2);
    padding: 10px 14px;
    text-align: left;
  }
  .post-prose th {
    background: var(--zx-hover);
    font-weight: 600;
  }
  .post-prose code {
    font-family: var(--zx-mono);
    font-size: 0.88em;
    background: var(--zx-hover);
    border-radius: 6px;
    padding: 2px 6px;
  }
  .post-prose hr {
    border: 0;
    border-top: 1px solid var(--zx-line);
    margin: 36px 0;
  }
  .post-prose img {
    max-width: 100%;
    border-radius: 12px;
  }

  .post-faq {
    margin: 48px 0 8px;
    border-top: 1px solid var(--zx-line);
    padding-top: 36px;
  }
  .post-faq h2 {
    font-family: var(--zx-display);
    font-size: 24px;
    font-weight: 700;
    margin: 0 0 18px;
  }
  .post-faq details {
    border: 1px solid var(--zx-line);
    border-radius: 12px;
    padding: 0;
    margin-bottom: 10px;
    background: var(--zx-panel);
  }
  .post-faq summary {
    cursor: pointer;
    padding: 16px 18px;
    font-weight: 600;
    list-style: none;
    position: relative;
    padding-right: 40px;
  }
  .post-faq summary::-webkit-details-marker {
    display: none;
  }
  .post-faq summary::after {
    content: "+";
    position: absolute;
    right: 18px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--zx-ink3);
    font-size: 18px;
  }
  .post-faq details[open] summary::after {
    content: "–";
  }
  .post-faq details p {
    padding: 0 18px 16px;
    margin: 0;
    color: var(--zx-ink2);
    line-height: 1.65;
  }

  .post-cta {
    margin: 44px 0;
    border: 1px solid var(--zx-line);
    border-radius: 20px;
    padding: clamp(24px, 4vw, 40px);
    background:
      radial-gradient(120% 160% at 100% 0%, rgba(237, 75, 0, 0.08), transparent 60%),
      var(--zx-panel);
  }
  .post-cta-kicker {
    font-family: var(--zx-mono);
    font-size: var(--zx-fs-label);
    letter-spacing: var(--zx-ls-label);
    text-transform: uppercase;
    color: var(--zx-lar);
    margin: 0 0 10px;
  }
  .post-cta h2 {
    font-family: var(--zx-display);
    font-size: clamp(22px, 2.6vw, 28px);
    font-weight: 700;
    margin: 0 0 10px;
  }
  .post-cta p {
    color: var(--zx-ink2);
    max-width: 520px;
    margin: 0 0 20px;
    line-height: 1.6;
  }

  .post-related {
    margin: 8px 0 clamp(64px, 10vh, 100px);
    border-top: 1px solid var(--zx-line);
    padding-top: 36px;
  }
  .post-related h2 {
    font-family: var(--zx-display);
    font-size: 22px;
    font-weight: 700;
    margin: 0 0 18px;
  }
  .post-related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  @media (max-width: 720px) {
    .post-related-grid { grid-template-columns: 1fr; }
  }
  .post-related-grid a {
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--zx-line);
    border-radius: 14px;
    padding: 18px;
    background: var(--zx-panel);
    transition: border-color 0.2s ease, transform 0.25s ease;
  }
  .post-related-grid a:hover {
    border-color: var(--zx-line-2);
    transform: translateY(-2px);
  }
  .post-related-grid strong {
    font-family: var(--zx-display);
    font-size: 15.5px;
    line-height: 1.35;
    font-weight: 700;
    flex: 1;
  }
</style>
