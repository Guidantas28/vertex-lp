---
// Rota /lp2 · a TERCEIRA página de anúncio, ao lado da /lp e da /lp1.
//
// 19/09/2026 (Orlando): esta é a /lp com a identidade do site novo, que o
// PR #18 tinha colocado NO LUGAR da /lp. Como a /lp é a que recebe o tráfego
// pago e ficou com a mesma cara da /lp1 no topo, ela foi devolvida ao estado
// anterior (fix 1aaa5e1) e esta versão veio morar aqui, em endereço próprio.
// As três convivem: /lp = a de sempre · /lp1 = uma dobra só · /lp2 = esta.
// A pele é o `lp-zx.css` (o `lp.css` do PR #18), dividida com a /lp1; o
// `lp.css` é só da /lp e não se toca sem ordem.
//
// Documento próprio, sem o chrome da home (Nav/Footer/tema). O que é compartilhado com o resto do site:
//   · GTM + primeiro toque (vos_ft)                     -> GtmHead/GtmNoScript/FirstTouch
//   · CTA -> mesma modal de lead (2 etapas) -> Cal.com  -> <LeadWizardModal/>
//   · a casca visual (tokens .zx, botão, faixa escura)  -> styles/zx.css + <ScrollBand/>
// Os CTAs têm data-action="lead"; o listener no fim do body dispara o evento
// "vos:open-lead", exatamente como na home.
//
// 18/09/2026 (founder): a /lp veste a IDENTIDADE do site novo . botão, cor e
// efeito . SEM mudar a copy nem o contexto. Mesma ordem de blocos, mesmos
// textos, mesmo rastreio e mesma modal. O que mudou é a pele: topo em Carvão
// como o hero da home, o painel entrando de perspectiva, a manuscrita Caveat,
// o botão MONO com a setinha que abre, a faixa escura que abre com o scroll,
// preço e dúvidas no papel e o fecho escuro com o rodapé dentro, como na home.
import "../styles/lp-zx.css";
import "../styles/zx.css";
import "../styles/lp-dobra.css";
import GtmHead from "../components/tracking/GtmHead.astro";
import GaHead from "../components/tracking/GaHead.astro";
import GtmNoScript from "../components/tracking/GtmNoScript.astro";
import FirstTouch from "../components/tracking/FirstTouch.astro";
import LeadWizardModal from "../components/islands/LeadWizardModal.tsx";
import ScrollBand from "../components/site/ScrollBand.astro";
import VslPlayer from "../components/lp/VslPlayer.astro";

const title = "VOS · Atendimento automático é só o começo";
const description =
  "No VOS, uma ação puxa a próxima: a mensagem vira atendimento, o atendimento vira negócio, e o negócio vira agenda e caixa. Sem ninguém precisar lembrar do passo seguinte.";
// Domínio REAL do site (o `site` do astro.config aponta pra osvertex.com, que
// hoje devolve 404 — canonical/og apontando pra lá quebrariam preview e SEO).
const SITE_URL = "https://www.voshq.com";
const url = `${SITE_URL}/lp2/`;
const ogImage = `${SITE_URL}/og.png`;

// Fonte ÚNICA dos planos (a spec §8 exige centralizar pra não divergir entre
// blocos). Valores e itens vêm SÓ do PRECOS_VOS_ATUAL.png. O que não estava
// legível na fonte não foi inventado — ver docs/vos-growth/LP_ARCHITECTURE.md.
// Exceção: o "R$ 197/mês no plano anual" (notaAnual + promo) é decisão de
// oferta do Orlando em 24/08 — não vem do print.
const PLANOS = [
  {
    nome: "Start",
    preco: "297",
    notaAnual: "ou R$ 197/mês no plano anual",
    beneficio: "Para começar a centralizar a operação e automatizar os primeiros processos.",
    resumo: null,
    itens: [
      "1 usuário",
      "CRM, atendimento em 2 canais e orçamentos",
      "Agenda, contatos e até 10 automações",
      "Estoque, pedidos, ordem de serviço e assinaturas",
      "Contas a pagar, receber e fornecedores",
    ],
    cta: "Ver o Start na demonstração",
  },
  {
    nome: "Essential",
    preco: "497",
    beneficio: "Para equipes que precisam conectar atendimento, vendas e operação.",
    resumo: "Tudo do Start, mais:",
    itens: [
      "5 usuários e atendimento em até 5 canais",
      "Assinatura digital — até 20 por mês",
      "Catálogo digital",
      "Nota fiscal",
      "Relatórios",
    ],
    cta: "Ver o Essential na demonstração",
    selo: "Mais escolhido",
  },
  {
    nome: "Scale",
    preco: "797",
    beneficio: "Para operações com mais pessoas, canais e volume.",
    resumo: "Tudo do Essential, mais:",
    itens: [
      "15 usuários",
      "Até 20 canais de atendimento",
      "Assinaturas digitais ilimitadas",
      "PDV",
    ],
    cta: "Ver o Scale na demonstração",
  },
];

// As mesmas sete integrações de antes (a lista é contexto, não pele); o que
// mudou é o desenho: os logos oficiais em ladrilho, o leque do hero da home.
const INTEGRACOES = [
  { nome: "WhatsApp", src: "/assets/integrations/whatsapp.svg", cor: "#25D366" },
  { nome: "Instagram", src: "/assets/integrations/instagram.png", cor: "#E1306C" },
  { nome: "Messenger", src: "/assets/integrations/messenger.svg", cor: "#0084FF" },
  { nome: "Meta", src: "/assets/integrations/meta.png", cor: "#0668E1" },
  { nome: "TikTok", src: "/assets/icons/tiktok.svg", cor: "#111111" },
  { nome: "Telegram", src: "/assets/icons/telegram.svg", cor: "#29A9EA" },
  { nome: "Claude", src: "/assets/integrations/claude.svg", cor: "#D97757" },
];

// O traço manuscrito que sublinha cada recado (desenhado no reveal).
const TRACO = "M2 7.4C46 3.1 120 1.9 178 3.4c22 .6 46 1.9 60 3.6";
---

<!doctype html>
<html lang="pt-BR">
<head>
  <GtmHead />
  <GaHead />
<meta charset="utf-8">
<script is:inline>document.documentElement.classList.add("js")</script>
<meta name="viewport" content="width=device-width, initial-scale=1">
<!-- Mesma marca do app (apps/web/app/icon.png), pra aba e atalho baterem com o produto -->
<link rel="icon" type="image/png" sizes="32x32" href="/lp/favicon.png">
<link rel="icon" type="image/png" sizes="192x192" href="/lp/icon-192.png">
<link rel="icon" type="image/png" sizes="512x512" href="/lp/icon-512.png">
<link rel="apple-touch-icon" href="/lp/apple-touch-icon.png">
<meta name="theme-color" content="#08090A">
<meta name="description" content="Atendimento automático é só o começo. No VOS, uma ação puxa a próxima — do primeiro oi ao dinheiro no caixa.">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<!-- Tipografia do site: Inter é a voz, Inter Tight (o Fio) é o display e
     Caveat é a manuscrita da marca — as três da home, no mesmo pedido. -->
<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Inter:wght@300..800&family=Inter+Tight:wght@300..700&display=swap" rel="stylesheet">
<!-- a capa do vídeo é o maior elemento da dobra: vem antes de tudo -->
<link rel="preload" as="image" href="/vsl/capa.webp" media="(min-width: 700px)" fetchpriority="high">
  <link rel="preload" as="image" href="/vsl/capa-vertical.webp" media="(max-width: 699px)" fetchpriority="high">
  <!-- Fontes da modal de lead (Geist/Jakarta/JetBrains Mono), pro wizard ficar
       igual ao do resto do site. A LP em si é Inter. -->
  <link
    href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
    rel="stylesheet"
  />
  <title>{title}</title>
  <!-- Landing de anúncio: vive de tráfego pago. Indexada, disputava com a home
       exatamente os mesmos termos e virou "Duplicate without user-selected
       canonical" no Search Console. `follow` mantido pra não cortar o fluxo de
       autoridade dos links internos daqui. Ela também sai do sitemap. -->
  <meta name="robots" content="noindex, follow" />
  <link rel="canonical" href={url} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={url} />
  <meta property="og:locale" content="pt_BR" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
</head>
<body>
<GtmNoScript />

<div class="zx lp">

  <!-- 1 | HERO. Message match com o Control: quem clicou no anuncio de
       "atendimento automatico" reconhece a pagina e e levado uma casa
       adiante. O H1 anterior ("a maneira mais facil ... em um so lugar")
       era o descritor de produto vendido como manchete, e brigava com a
       tese da secao seguinte.
       18/09 (founder): o topo segue o PADRÃO da /lp1 ("a /lp precisa ficar
       nesse padrão também, pra celular e desktop"): no celular a coluna
       centrada que começa colada no lockup, com a manchete no maior tamanho
       que cabe; no desktop a copy à esquerda e o vídeo à direita. A peça é a
       mesma das duas páginas (styles/lp-dobra.css + components/lp/
       VslPlayer.astro). A copy é a de antes; o "para empresas que vivem de
       WhatsApp" virou o rótulo do padrão (Inter, primeira letra maiúscula,
       ícone na frente). O painel do sistema continua logo abaixo da dobra,
       entrando de perspectiva. O header continua sem link nenhum: em tráfego
       frio, saída antes de motivo pra ficar é vazamento. -->
  <div class="lp-hero">
    <div class="lp-pele" aria-hidden="true">
      <div class="lp-pele-luz"></div>
      <div class="lp-pele-pontos"></div>
      <div class="lp-pele-grao"></div>
    </div>

    <div class="dobra-palco">
      <div class="dobra-aurora" aria-hidden="true"></div>

      <div class="hdr dobra-hdr">
        <!-- lockup MONO oficial, na versão branca porque o topo é escuro.
             Nunca redesenhar a logo em código. -->
        <div class="logo">
          <img src="/lp/vos-logo-mono-white.png" alt="VOS" width="901" height="277">
        </div>
      </div>

      <section class="dobra">
        <p class="dobra-kicker reveal"><svg class="dobra-kicker-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg><span>Para empresas que vivem de WhatsApp</span></p>
        <h1 class="reveal d1">Atendimento automático<br><em>é só o começo.</em></h1>
        <p class="dobra-sub reveal d2">Atendimento, CRM, vendas, orçamento, contratos, agenda, serviços, financeiro e automações trabalhando dentro do mesmo sistema</p>

        <div class="dobra-video reveal d2">
          <VslPlayer ctaFim="Agendar demonstração" />
        </div>

        <div class="dobra-acao reveal d3">
          <a href="#agendar" class="cta cta--white cta--lg" data-action="lead"><span class="cta-l">Agendar demonstração</span><i class="cta-chev" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></i></a>
          <p class="dobra-atrito">30 minutos, sem cartão e sem instalar nada. Você vê o sistema por dentro, módulo por módulo, e pergunta o que quiser — ao vivo.</p>
        </div>

        <div class="dobra-integr reveal d3">
          <div class="dobra-ints">
            <span class="lb">Integrações oficiais</span>
            <div class="dobra-ints-linha">
              <ul class="ics" aria-label="Integrações oficiais do VOS">
                {INTEGRACOES.map((it, i) => (
                  <li class="ic" style={`--c:${it.cor};z-index:${INTEGRACOES.length - i}`}>
                    <img src={it.src} alt={it.nome} title={it.nome} width="34" height="34" loading="eager" decoding="async">
                  </li>
                ))}
              </ul>
              <span class="dobra-mais">
                <svg width="30" height="18" viewBox="0 0 36 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M34 15C26 3 14 3 3 10" />
                  <path d="M9 5L3 10l6 4" />
                </svg>
                e muito mais
              </span>
            </div>
          </div>
          <div class="dobra-prova proof">
            <div class="pf">
              <svg class="pf-meta" viewBox="0 0 36 20" fill="none" stroke="currentColor"
                   stroke-width="2.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 10c2.6-4.6 4.9-6.6 7.6-6.6 3.4 0 5.9 3 5.9 6.6s-2.5 6.6-5.9 6.6c-2.7 0-5-2-7.6-6.6-2.6-4.6-4.9-6.6-7.6-6.6C7 3.4 4.5 6.4 4.5 10s2.5 6.6 5.9 6.6c2.7 0 5-2 7.6-6.6Z"/>
              </svg>
              <span class="pf-txt"><b>Meta</b> Business Partner</span>
            </div>
            <span class="pf-sep" aria-hidden="true"></span>
            <div class="pf">
              <img class="pf-logo" src="/lp/vos-logo-mono-white.png" alt="VOS" width="901" height="277">
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- A cara do sistema. Mesma imagem que está no hero de voshq.com
         (/assets/hero/dashboard.webp, usada pelo Hero4 da home). width/height
         batem com o arquivo (3200x1900) para não gerar CLS.
         18/09: sai do Carvão e pousa no papel (metade de cada lado), e entra
         de perspectiva: começa inclinada e assenta conforme a página desce.
         Mora logo abaixo da dobra do vídeo, então carrega preguiçosa. -->
    <figure class="hero-tela">
      <img src="/assets/hero/dashboard.webp"
           alt="Tela do VOS: painel com funil de venda, receita, fluxo de caixa e o menu de módulos à esquerda"
           width="3200" height="1900" loading="lazy" decoding="async">
    </figure>
  </div>

  <!-- Aqui viviam o bloco de problema, a faixa do mecanismo e as tres
       provas vivas. Removidos a pedido do Orlando em 19/08 — a area fica
       vazia de proposito, para ser refeita. Os motores animados que os
       moviam sairam no commit d3ce2f2, JS e CSS na mesma passada: nao ha
       nada orfao aqui esperando a marcacao voltar. -->

  <!-- ══ Fluxo Contínuo VOS ══
       Aqui vivia a CADEIA: 9 etapas em 3 fases, dois estados ("Do jeito
       manual" x "Com o VOS"), selo por cartao, relogio no cartao 3 e uma
       cena animada em video por cartao. Removida a pedido do Orlando em
       19/08 — fica so a copy do cabecalho. O motor (JS) saiu junto, na
       mesma passada. Os renders /lp/cena-trabalho.{webm,mp4,png} foram
       APAGADOS em 20/08; o fonte que os gera segue versionado
       (LpCenaTrabalho, commit e7ef105 do D:VIDEO-FACTORY). -->
  <section class="lp-cena">
    <div class="band-head">
      <div class="eb reveal"><u>você digita uma vez só<svg viewBox="0 0 240 10" preserveAspectRatio="none"><path d={TRACO}/></svg></u></div>
      <h2 class="reveal d1">A conversa no WhatsApp <u>já é o orçamento, o pedido e a nota fiscal.</u></h2>
      <p class="reveal d2">O cliente escreve. O VOS responde, salva o contato, monta o orçamento e emite a nota. Nada é copiado de uma tela para outra.</p>
    </div>

    <!-- ══ A CENA: a conversa de um lado, os modulos do outro ══
         Video, e nao animacao de DOM: sao 14 bolhas com rolagem, indicador de
         digitacao e sete acendimentos sincronizados. Fonte da peca versionado
         em D:VIDEO-FACTORY (composicao VosPainelWhats). Um arquivo so desde
         20/08, com os <source> estaticos.

         🔴 SEM BOTAO DE PAUSAR, e isso tem custo. Movimento que comeca sozinho,
         passa de 5s e divide a tela com texto exige um mecanismo de pausar
         (WCAG 2.2.2, nivel A). E decisao do Orlando, tomada com o custo na
         mesa: ele quer que leia como GIF. A unica atenuacao que sobra e o
         prefers-reduced-motion, que nao dispara o autoplay. -->
    <div class="band-cena reveal d2">
      <div class="cena" id="cena">
        <video id="cenaVid" class="cena-v" poster="/lp/vos-cena-poster.webp"
               playsinline muted loop preload="none" aria-label="Uma conversa de WhatsApp do primeiro contato ate a nota fiscal, com os modulos do VOS acendendo a cada etapa">
          <source src="/lp/vos-cena.webm" type="video/webm">
          <source src="/lp/vos-cena.mp4" type="video/mp4">
        </video>
      </div>
    </div>
  </section>

  <!-- 6 | DO PRIMEIRO OI AO CAIXA. A spec pede continuidade, nao
       lista de features - por isso a copy narra o percurso.
       18/09: mora na faixa escura que ABRE com o scroll, a mesma da home. -->
  <ScrollBand class="lp-band">
    <div class="lp-band-in">
      <div class="band-head">
        <div class="eb reveal"><u>Conheça o VOS<svg viewBox="0 0 240 10" preserveAspectRatio="none"><path d={TRACO}/></svg></u></div>
        <p class="reveal d1">Conecta atendimento, automações, vendas, notas fiscais e a gestão inteira em um único lugar.</p>
      </div>

      <div class="band-video reveal d2">
        <div class="player" id="player">
          <video id="vid" src="/lp/broll.mp4#t=0.5" poster="/lp/broll-poster.jpg"
                 playsinline muted preload="metadata" controlslist="nodownload"></video>
          <button type="button" class="capa" id="capa" aria-label="Assistir ao vídeo">
            <span class="play"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.2v13.6L19 12 8 5.2Z"/></svg></span>
            <span class="rot">Conheça o VOS</span>
          </button>
          <button type="button" class="som" id="som" aria-label="Ativar o som do vídeo">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5Z"/><path d="M22 9l-6 6M16 9l6 6"/></svg>
            Ativar Som
          </button>
        </div>
      </div>
    </div>
  </ScrollBand>

  <!-- ⚰️ Aqui vivia a esteira de 15 depoimentos. Eles eram FICTICIOS e saem a
       pedido do Orlando em 19/08. No lugar entra prova de mecanismo: a cena la
       em cima mostra a venda inteira acontecendo. As mesmas 15 fotos seguem em
       src/data/content.ts, alimentando a HOME. Outra superficie, outra decisao. -->

  <!-- 8 | PRECOS. Value stack antes do numero, e os planos saem do array
       PLANOS do frontmatter - fonte unica, como a spec exige.
       18/09: no papel, com o card do preço da home (régua de acento no
       destaque, selo em tinta, botão MONO). -->
  <section class="lp-precos" id="precos">
    <div class="band-head planos-sep">
      <div class="eb reveal"><u>quanto custa<svg viewBox="0 0 240 10" preserveAspectRatio="none"><path d={TRACO}/></svg></u></div>
      <h2 class="reveal d1">Um sistema para a empresa inteira.</h2>
      <p class="stack reveal d2">Atendimento, CRM, automações, agenda, operação e financeiro trabalhando juntos.</p>
      <p class="ancora reveal d2">Planos a partir de <b>R$ 197/mês</b> no plano anual.</p>
    </div>

    <!-- Promo (24/08): a T07 anuncia "a partir de R$ 197/mes" e a pagina tem
         que responder com o mesmo numero. Termos reais: Start no plano anual
         (de R$ 297 no mensal). Sem urgencia por decisao do Orlando — o gancho
         e agendar a demonstracao, nao o relogio. -->
    <aside class="promo reveal">
      <div class="promo-txt">
        <span class="promo-selo">Promoção</span>
        <p class="promo-t">Agende a demonstração e leve o Start por <b>R$ 197/mês</b>.</p>
        <p class="promo-p">De <s>R$ 297</s> por <b>R$ 197/mês</b> no plano anual — R$ 1.200 a menos no primeiro ano. Condição garantida na demonstração.</p>
      </div>
      <a href="#agendar" class="cta promo-cta" data-action="lead"><span class="cta-l">Agendar demonstração</span><i class="cta-chev" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></i></a>
    </aside>

    <div class="planos stagger">
      {PLANOS.map((pl) => (
        <article class={pl.selo ? "plano plano-destaque" : "plano"} data-tilt>
          <div class="plano-topo">
            <h3 class="plano-nome">{pl.nome}</h3>
            {pl.selo && <span class="plano-selo">{pl.selo}</span>}
          </div>
          <p class="plano-preco"><b>R$ {pl.preco}</b><span>/mês</span></p>
          {pl.notaAnual && <p class="plano-nota">{pl.notaAnual}</p>}
          <p class="plano-benef">{pl.beneficio}</p>
          <div class="plano-lista">
            {pl.resumo && <p class="plano-resumo">{pl.resumo}</p>}
            <ul class="plano-itens">
              {pl.itens.map((it) => <li>{it}</li>)}
            </ul>
          </div>
          <a href="#agendar" class={pl.selo ? "cta cta-2" : "cta cta--soft cta-2"} data-action="lead"><span class="cta-l">{pl.cta}</span><i class="cta-chev" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></i></a>
        </article>
      ))}
    </div>

    <!-- Reduz a paralisia de escolher entre tres opcoes: em vez de mandar a
         pessoa decidir sozinha, joga a decisao pra dentro da demonstracao. -->
    <div class="ajuda reveal">
      <svg class="ajuda-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.2a2.6 2.6 0 1 1 3.4 2.5c-.6.2-.9.7-.9 1.3v.4"/><path d="M12 16.8h.01"/></svg>
      <p class="ajuda-t">Não sabe qual plano faz sentido para a sua empresa?</p>
      <p class="ajuda-alivio">Você não precisa decidir agora.</p>
      <p class="ajuda-p">Na demonstração a gente entende como a sua operação funciona e mostra qual plano cobre o que você realmente precisa.</p>
