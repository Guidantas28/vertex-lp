---
// Casca das páginas do blog: Base + Nav4 + Footer4 com os tokens .zx.
// Os tokens vêm de styles/zx-shell.css, compartilhado com as páginas de módulo
// (a home declara os seus no próprio index.astro — manter em sincronia se ela mudar).
import "../styles/zx-shell.css";
import Base from "./Base.astro";
import Nav4 from "../components/v4/Nav4.astro";
import Footer4 from "../components/v4/Footer4.astro";
import LeadWizardModal from "../components/islands/LeadWizardModal.tsx";
import { SITE } from "../data/content";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: string;
  /** Objetos JSON-LD extras (Article, FAQPage, Breadcrumb…) */
  schema?: Record<string, unknown>[];
}

const { title, description, canonical, ogType = "website", schema = [] } = Astro.props;
---

<Base {title} {description} {canonical} {ogType} noDefaultSchema>
  <Fragment slot="head">
    {schema.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}
  </Fragment>

  <script is:inline define:vars={{ signupUrl: SITE.signupUrl }}>
    window.__VOS_SIGNUP_URL__ = signupUrl;
  </script>

  <div class="zx">
    <Nav4 />
    <main class="blogshell-main">
      <slot />
    </main>
    <div class="blogshell-footer">
      <Footer4 />
    </div>
    <LeadWizardModal client:idle />
  </div>
</Base>

<style is:global>
  .blogshell-main {
    min-height: 60vh;
  }

  /* O Footer4 é claro-sobre-escuro e espera uma faixa escura atrás. */
  .blogshell-footer {
    background: #0d0c15;
  }

  /* Peças compartilhadas entre índice, categoria e post. */
  .blog-chip {
    align-self: flex-start;
    display: inline-block;
    font-family: var(--zx-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cat, var(--zx-lar));
    border: 1px solid var(--zx-line-2);
    border-color: color-mix(in srgb, var(--cat, var(--zx-lar)) 35%, transparent);
    border-radius: 999px;
    padding: 4px 10px;
  }
  .blog-meta {
    font-size: 12.5px;
    color: var(--zx-ink3);
  }
</style>
