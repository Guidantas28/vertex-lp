---
// CTA final + footer: uma faixa ScrollBand contínua (mesmo fundo/efeito).
import ScrollBand from "../site/ScrollBand.astro";
import Footer4 from "./Footer4.astro";
import { GetStartedButton } from "../ui/get-started-button";
---

<section class="zx-ctafinal">
  <ScrollBand class="zx-ctafinal-band" fullBleed>
    <div class="zx-ctafinal-inner">
      <div class="zx-container">
        <h2 class="reveal">
          Toda a sua empresa.<br />Em um lugar <strong>só</strong>.
        </h2>
        {/* Um botão só, no meio (founder 15/09). O "Ver a plataforma" mandava
            pra uma âncora que o visitante já passou pra chegar aqui, e a linha
            de apoio saiu junto: o fecho é o título e o convite, nada mais. */}
        <div class="zx-ctafinal-actions reveal reveal-delay-1">
          <GetStartedButton client:visible variant="white" label="Teste grátis" />
        </div>
      </div>
    </div>
    <Footer4 />
  </ScrollBand>
</section>

<style>
  .zx-ctafinal { padding: 0; }
  .zx-ctafinal-inner {
    padding-block: clamp(96px, 16vh, 160px) clamp(32px, 5vh, 48px);
    text-align: center;
  }
  .zx-ctafinal-inner h2 {
    margin: 0;
    font-family: var(--zx-display);
    font-size: var(--zx-fs-display);
    line-height: var(--zx-lh-display);
    letter-spacing: var(--zx-ls-display);
    font-weight: var(--zx-fw-title-dark);
    color: var(--zx-on-dark);
    text-wrap: balance;
  }
  .zx-ctafinal-inner h2 strong { font-weight: var(--zx-fw-emphasis); }
  .zx-ctafinal-actions {
    display: flex;
    justify-content: center;
    gap: 12px;
    /* sem a linha de apoio no meio, o botão precisa do respiro que era dela */
    margin-top: clamp(30px, 4.5vh, 44px);
    flex-wrap: wrap;
  }

  /* NO CELULAR o fecho SAI (founder 15/09: "remove do footer essa parte somente
     no mobile"): "Teste grátis" já está na barra do topo, no fim dos três
     passos e em cada plano . no dedo, mais um convite no pé é meia tela de
     rolagem repetindo o que a pessoa acabou de ler. O rodapé continua. */
  @media (max-width: 760px) {
    .zx-ctafinal-inner { display: none; }
  }
</style>
