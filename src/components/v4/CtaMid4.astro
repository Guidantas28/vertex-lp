---
// CTA curto no fim da faixa dark (mesmo fundo do ScrollBand).
import { GetStartedButton } from "../ui/get-started-button";
---

<section class="zx-ctamid" aria-labelledby="zx-ctamid-title">
  <div class="zx-container zx-ctamid-inner">
    <p class="zx-ctamid-hand reveal" aria-hidden="true">
      Sem enrolação
      <svg class="zx-ctamid-hand-line" viewBox="0 0 200 12" fill="none" preserveAspectRatio="none" aria-hidden="true">
        <path d="M3 8c40-6 120-7 194-3" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
      </svg>
    </p>
    <h2 id="zx-ctamid-title" class="reveal reveal-delay-1">
      Vamos começar a escalar hoje?
    </h2>
    <p class="zx-ctamid-sub reveal reveal-delay-1">
      CRM, atendimento e financeiro num lugar só — com o Zé no braçal.
    </p>
    <div class="zx-ctamid-actions reveal reveal-delay-2">
      <GetStartedButton client:visible variant="white" label="Começar Agora" />
      <a class="zx-ctamid-more" href="#faq">Ver dúvidas</a>
    </div>
  </div>
</section>

<style>
  .zx-ctamid {
    position: relative;
    padding: clamp(36px, 5vh, 56px) 0 clamp(48px, 7vh, 72px);
    text-align: center;
    background: transparent;
  }
  .zx-ctamid-inner { position: relative; }

  .zx-ctamid-hand {
    position: relative;
    display: inline-block;
    margin: 0 0 6px;
    font-family: "Caveat", cursive;
    font-weight: 700;
    font-size: clamp(26px, 3.2vw, 38px);
    line-height: 0.95;
    color: #FFBE5A;
    transform: rotate(-3deg);
  }
  .zx-ctamid-hand-line {
    position: absolute;
    left: -2%;
    bottom: -0.28em;
    width: 104%;
    height: 0.42em;
    color: color-mix(in srgb, #FFBE5A 80%, transparent);
    overflow: visible;
  }
  :global(.reveal.is-visible) .zx-ctamid-hand {
    animation: ctamid-write 1.2s cubic-bezier(0.66, 0, 0.34, 1) 0.1s both;
  }
  @keyframes ctamid-write {
    from { clip-path: inset(-24% 100% -34% -6%); }
    to   { clip-path: inset(-24% -10% -34% -6%); }
  }

  .zx-ctamid h2 {
    margin: 8px auto 0;
    max-width: 16ch;
    font-family: var(--zx-display);
    font-size: var(--zx-fs-title);
    line-height: var(--zx-lh-title);
    letter-spacing: var(--zx-ls-title);
    font-weight: var(--zx-fw-title);
    color: #F2F0FA;
    text-wrap: balance;
  }
  .zx-ctamid-sub {
    margin: 10px auto 0;
    max-width: 420px;
    padding-inline: 12px;
    font-family: var(--zx-body);
    font-size: var(--zx-fs-body);
    font-weight: var(--zx-fw-body);
    line-height: var(--zx-lh-body);
    color: rgba(242, 240, 250, 0.68);
  }
  .zx-ctamid-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 10px 16px;
    margin-top: 18px;
    padding-inline: 12px;
  }
  .zx-ctamid-more {
    color: rgba(255, 255, 255, 0.85);
    font-size: var(--zx-btn-fs);
    font-weight: var(--zx-btn-fw);
    line-height: var(--zx-btn-lh);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .zx-ctamid-more:hover { color: #fff; }

  @media (prefers-reduced-motion: reduce) {
    .zx-ctamid-hand { animation: none; }
  }
</style>
