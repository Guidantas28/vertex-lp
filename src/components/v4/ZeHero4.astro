---
// Apresentação da IA (Zé) em modo LIGHT estilo ClickUp: fundo claro da página,
// painel com o gradiente da marca (roxo→vermelho→laranja granulado) em tilt 3D,
// anotações mono com linha e a island ZeRevealAI (óculos + nuvem digitada).
import { ZeRevealAI } from "../islands/ZeRevealAI";
import { SITE } from "../../data/content";

// vídeo do Zé flutuando só funciona em fundo escuro (blend screen); no light fica off.
// Pra reativar em faixa dark: videoSrc="/mascote/ze-float.mp4".
---

<ZeRevealAI client:visible size={340} signupUrl={SITE.signupUrl} />

<style is:global>
  .zx-zehero {
    position: relative;
    background: transparent; /* herda o paper light da página */
    padding: clamp(56px, 9vh, 110px) clamp(10px, 1.6vw, 20px);
  }
  .zx-zehero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(24px, 5vw, 72px);
  }

  /* PALCO: Zé direto no light, sem painel */
  .zx-zehero-stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 480px;
  }

  /* camada 1: entrada lateral (Zé desliza da esquerda) */
  .zx-zehero-enter {
    opacity: 0;
    transform: translateX(-14%);
  }
  .zx-zehero-enter.is-in {
    animation: zehero-slide 0.85s var(--ease-vos, cubic-bezier(0.22, 1, 0.36, 1)) both;
  }
  @keyframes zehero-slide {
    0%   { opacity: 0; transform: translateX(-16%) rotate(-5deg); }
    60%  { opacity: 1; transform: translateX(2.5%) rotate(1.5deg); }
    100% { opacity: 1; transform: translateX(0) rotate(0); }
  }

  /* camada 2: tilt 3D no ponteiro (sem animação própria, só o inline do script).
     Só perspective (sem preserve-3d) pra o anel 2D não brigar de profundidade
     com o giro 3D do Zé. */
  .zx-zehero-figure {
    position: relative;
    perspective: 1000px;
    will-change: transform;
    transition: transform 0.25s var(--ease-vos, ease);
  }
  @property --ring-a {
    syntax: "<angle>";
    initial-value: 0deg;
    inherits: false;
  }
  @property --ring-b {
    syntax: "<angle>";
    initial-value: 180deg;
    inherits: false;
  }

  /* camada 3: giro de super-herói (dispara quando a fala termina) */
  .zx-zehero-spin { position: relative; transform-style: preserve-3d; }
  .zx-zehero-spin.is-spin {
    animation: zehero-herospin 1.65s cubic-bezier(0.34, 0.85, 0.3, 1) both;
  }
  /* DUAS voltas completas, pulo mais alto e squash mais marcado */
  @keyframes zehero-herospin {
    0%   { transform: rotateY(0) translateY(0) scale(1); }
    14%  { transform: rotateY(80deg) translateY(-5%) scale(1.04); }
    62%  { transform: rotateY(650deg) translateY(-11%) scale(1.08); }
    78%  { transform: rotateY(720deg) translateY(2.5%) scale(0.95, 1.05); }
    88%  { transform: rotateY(720deg) translateY(-1.5%) scale(1.02, 0.985); }
    100% { transform: rotateY(720deg) translateY(0) scale(1); }
  }
  /* anel DOURADO HORIZONTAL orbitando a cintura do Zé (elipse achatada) —
     o segmento brilhante varre em volta dele via --ring-a. Fica ATRÁS do Zé. */
  .zx-zehero-spinfx {
    position: absolute;
    left: 50%; top: 59%;
    width: 98%; aspect-ratio: 1;
    transform: translate(-50%, -50%) scaleY(0.3);
    border-radius: 50%;
    background: conic-gradient(
      from var(--ring-a),
      transparent 0 48%,
      rgba(255, 224, 160, 0.85) 60%,
      #FFBE5A 74%,
      #FF8A3D 86%,
      rgba(255, 138, 61, 0) 99%
    );
    -webkit-mask: radial-gradient(closest-side, transparent 85%, #000 87.5%);
    mask: radial-gradient(closest-side, transparent 85%, #000 87.5%);
    filter: drop-shadow(0 0 12px rgba(255, 190, 90, 0.65));
    opacity: 0;
    pointer-events: none;
    z-index: 0;
  }
  /* segundo cometa dourado, defasado 180°, orbitando junto */
  .zx-zehero-spinfx::after {
    content: "";
    position: absolute;
    inset: -4.5%;
    border-radius: 50%;
    background: conic-gradient(
      from var(--ring-b),
      transparent 0 58%,
      rgba(255, 224, 160, 0.7) 70%,
      #FFD98A 80%,
      rgba(255, 190, 90, 0) 94%
    );
    -webkit-mask: radial-gradient(closest-side, transparent 86%, #000 88.5%);
    mask: radial-gradient(closest-side, transparent 86%, #000 88.5%);
  }
  .zx-zehero-figure.is-spin .zx-zehero-spinfx {
    animation: zehero-orbit 1.7s ease-in-out both;
  }
  /* mais de duas voltas do cometa principal, com pulso de brilho no pico */
  @keyframes zehero-orbit {
    0%   { opacity: 0; --ring-a: -60deg; --ring-b: 140deg;
           filter: drop-shadow(0 0 10px rgba(255, 190, 90, 0.45)); }
    10%  { opacity: 1; }
    50%  { filter: drop-shadow(0 0 26px rgba(255, 190, 90, 0.95)); }
    82%  { opacity: 1; }
    100% { opacity: 0; --ring-a: 790deg; --ring-b: 990deg;
           filter: drop-shadow(0 0 10px rgba(255, 190, 90, 0.45)); }
  }

  /* camada 4: flutuação */
  .zx-zehero-ze {
    position: relative;
    z-index: 2;
    animation: zehero-float 5.2s ease-in-out 3s infinite;
  }
  @keyframes zehero-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  .zx-zehero-still {
    position: absolute;
    inset: 0;
    filter: drop-shadow(0 36px 48px rgba(40, 12, 70, 0.35));
    transition: opacity 0.9s ease;
  }
  .zx-zehero-ze.is-video .zx-zehero-still { opacity: 0; }

  /* sombra de chão no light */
  .zx-zehero-floor {
    position: absolute;
    left: 50%;
    bottom: 4%;
    width: 52%;
    height: 30px;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(40, 20, 80, 0.28), transparent 68%);
    filter: blur(8px);
    z-index: 1;
  }

  .zx-zehero-gog { opacity: 0; will-change: transform, opacity; }
  .zx-zehero-full { opacity: 0; }
  .zx-zehero-flash {
    position: absolute;
    left: 50%; top: 33%;
    width: 46%; aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 220, 140, 0.95), rgba(237, 75, 0, 0) 62%);
    opacity: 0;
    pointer-events: none;
  }
  .zx-zehero-video {
    opacity: 0;
    transition: opacity 0.9s ease;
    mix-blend-mode: screen;
    -webkit-mask-image: radial-gradient(closest-side, #000 62%, transparent 96%);
    mask-image: radial-gradient(closest-side, #000 62%, transparent 96%);
  }
  .zx-zehero-video.is-ready { opacity: 1; }

  /* autoplay ao entrar na viewport: Zé entra e os óculos JÁ caem girando (0.4s+0.95s) */
  .zx-zehero-ze.is-play .zx-zehero-gog {
    animation: zehero-spin-drop 0.95s cubic-bezier(0.5, 1.4, 0.45, 1) 0.4s both;
  }
  .zx-zehero-ze.is-play .zx-zehero-full {
    animation: zehero-fadein 0.35s ease 1.15s both;
  }
  .zx-zehero-ze.is-play .zx-zehero-flash {
    animation: zehero-flash 0.95s ease 0.4s both;
  }
  .zx-zehero-ze.is-static .zx-zehero-gog { opacity: 1; }
  .zx-zehero-ze.is-static .zx-zehero-full { opacity: 1; }

  /* queda com giro completo + overshoot de encaixe */
  @keyframes zehero-spin-drop {
    0%   { transform: translateY(-70%) rotate(-380deg) scale(1.25); opacity: 0; }
    12%  { opacity: 1; }
    52%  { transform: translateY(-6%) rotate(-24deg) scale(1.06); }
    68%  { transform: translateY(3.5%) rotate(6deg) scale(0.97); }
    80%  { transform: translateY(-1.5%) rotate(-2deg) scale(1.02); }
    100% { transform: translateY(0) rotate(0) scale(1); opacity: 1; }
  }
  @keyframes zehero-fadein { from { opacity: 0; } to { opacity: 1; } }
  @keyframes zehero-flash {
    0%, 62% { opacity: 0; transform: translate(-50%, -50%) scale(0.5); }
    74%     { opacity: 0.9; transform: translate(-50%, -50%) scale(1); }
    88%     { opacity: 0; transform: translate(-50%, -50%) scale(1.5); }
    100%    { opacity: 0; }
  }

  /* ANOTAÇÕES MONO no fundo light, linhas apontando pro Zé (ref ClickUp) */
  .zx-zehero-tag {
    position: absolute;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--zx-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--zx-ink2);
    white-space: nowrap;
    pointer-events: none;
  }
  .zx-zehero-tag i {
    display: block;
    width: clamp(38px, 4.4vw, 70px);
    height: 1px;
    background: var(--zx-line-2);
  }
  .zx-zehero-tag--tl { top: 10%; left: 0; }
  .zx-zehero-tag--tl i { transform: rotate(28deg); transform-origin: left center; }
  .zx-zehero-tag--br { bottom: 8%; right: 0; }
  .zx-zehero-tag--br i { transform: rotate(28deg); transform-origin: right center; }

  /* NUVEM DE FALA */
  .zx-zehero-bubble {
    --bub-bg: rgba(32, 29, 54, 0.95);
    --bub-line: rgba(255, 255, 255, 0.14);
    position: absolute;
    left: 58%;
    top: 4%;
    z-index: 4;
    width: 232px;
    padding: 12px 15px;
    border-radius: 18px 18px 18px 6px;
    background: var(--bub-bg);
    border: 1px solid var(--bub-line);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 18px 44px -18px rgba(23, 10, 60, 0.45);
    transform-origin: 8% 100%;
    animation: zehero-bubble-pop 0.55s var(--ease-vos, cubic-bezier(0.22, 1, 0.36, 1)) both;
  }
  .zx-zehero-bubble::after {
    content: "";
    position: absolute;
    left: 15px;
    bottom: -6px;
    width: 13px;
    height: 13px;
    background: var(--bub-bg);
    border-right: 1px solid var(--bub-line);
    border-bottom: 1px solid var(--bub-line);
    transform: rotate(45deg);
    border-radius: 1px 2px 4px 2px;
  }
  .zx-zehero-bubble p {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.5;
    font-weight: 550;
    color: #F4F2FF;
    min-height: 1.5em;
  }
  @keyframes zehero-bubble-pop {
    from { opacity: 0; transform: scale(0.82) translateY(8px); }
    to   { opacity: 1; transform: scale(1) translateY(0); }
  }
  .zx-zehero-dots {
    display: inline-flex;
    gap: 5px;
    padding: 4px 0 2px;
  }
  .zx-zehero-dots i {
    width: 6px;
    height: 6px;
    border-radius: 99px;
    background: rgba(233, 229, 255, 0.65);
    animation: zehero-dot 1.1s ease-in-out infinite;
  }
  .zx-zehero-dots i:nth-child(2) { animation-delay: 0.15s; }
  .zx-zehero-dots i:nth-child(3) { animation-delay: 0.3s; }
  @keyframes zehero-dot {
    0%, 100% { opacity: 0.35; transform: translateY(0); }
    40% { opacity: 1; transform: translateY(-3px); }
  }
  .zx-zehero-caret {
    display: inline-block;
    width: 1.5px;
    height: 1em;
    margin-left: 2px;
    vertical-align: text-bottom;
    background: var(--zx-roxo-2);
    animation: zehero-caret 0.9s steps(1) infinite;
  }
  @keyframes zehero-caret { 50% { opacity: 0; } }

  /* COPY — callout manuscrito (Caveat), no estilo “feito pra você” */
  .zx-zehero-hand {
    position: relative;
    display: inline-block;
    margin: 0 0 4px;
    font-family: "Caveat", cursive;
    font-weight: 700;
    font-size: clamp(26px, 3.4vw, 40px);
    line-height: 0.95;
    color: var(--zx-lar, #ED4B00);
    transform: rotate(-3.5deg);
  }
  .zx-zehero-hand-line {
    position: absolute;
    left: -2%;
    bottom: -0.28em;
    width: 104%;
    height: 0.42em;
    color: color-mix(in srgb, var(--zx-lar, #ED4B00) 78%, transparent);
    overflow: visible;
  }
  :global(.reveal.is-visible) .zx-zehero-hand {
    animation: zehero-write 1.3s cubic-bezier(0.66, 0, 0.34, 1) 0.15s both;
  }
  @keyframes zehero-write {
    from { clip-path: inset(-24% 100% -50% -6%); }
    to   { clip-path: inset(-24% -10% -50% -6%); }
  }
  .zx-zehero-copy h2 {
    margin: 18px 0 0;
    font-family: var(--zx-display);
    font-size: var(--zx-fs-title);
    line-height: var(--zx-lh-title);
    letter-spacing: var(--zx-ls-title);
    font-weight: var(--zx-fw-title);
    color: var(--zx-ink);
    text-wrap: balance;
  }
  .zx-zehero-sub {
    margin: 16px 0 0;
    max-width: 460px;
    font-family: var(--zx-body);
    font-size: var(--zx-fs-body);
    font-weight: var(--zx-fw-body);
    line-height: var(--zx-lh-body);
    color: var(--zx-ink2);
  }
  .zx-zehero-copy .zx-btn { margin-top: 24px; }

  @media (max-width: 860px) {
    .zx-zehero-grid { grid-template-columns: 1fr; text-align: center; }
    .zx-zehero-hand { margin-inline: auto; }
    .zx-zehero-sub { margin-inline: auto; }
    .zx-zehero-stage { min-height: 360px; order: -1; }
    .zx-zehero-tag--tl { left: 0; top: 4%; }
    .zx-zehero-tag--br { right: 0; bottom: 2%; }
    .zx-zehero-tag i { display: none; }
    .zx-zehero-bubble { left: auto; right: 0; top: 0; width: 200px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .zx-zehero-hand { animation: none; clip-path: none; }
    .zx-zehero-enter { animation: none; opacity: 1; transform: none; }
    .zx-zehero-spin.is-spin { animation: none; }
    .zx-zehero-spinfx { display: none; }
    .zx-zehero-ze { animation: none; }
    .zx-zehero-ze .zx-zehero-gog,
    .zx-zehero-ze .zx-zehero-full { animation: none; opacity: 1; }
    .zx-zehero-bubble { animation: none; }
    .zx-zehero-dots i { animation: none; }
    .zx-zehero-caret { display: none; }
  }
</style>
