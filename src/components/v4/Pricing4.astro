---
// Preços: ciclo + add-ons interativos (React island).
import { PRICING, SITE } from "../../data/content";
import PricingInteractive from "../islands/PricingInteractive";
---

<section class="zx-pricing" id="precos">
  <div class="zx-container">
    <h2 class="zx-h2 reveal">Um preço que cabe<br />em cada fase.</h2>
    <p class="zx-lead reveal reveal-delay-2">{PRICING.lead}</p>

    <div class="reveal reveal-delay-2">
      <PricingInteractive
        client:visible
        plans={PRICING.plans}
        addons={PRICING.addons}
        signupUrl={SITE.signupUrl}
      />
    </div>
  </div>
</section>

<style>
  .zx-pricing { padding: clamp(72px, 12vh, 130px) 0 0; }
  .zx-pricing .zx-lead { max-width: 640px; }
</style>
