---
// Rodapé escuro: logo, blurb, colunas e newsletter.
// 15/09: saíram os selos (LGPD · Hospedado no Brasil · ICP-Brasil) e os logos de parceiro
// (Meta e TikTok), a pedido do founder.
import Logo from "../site/Logo.astro";
import { FOOTER } from "../../data/content";
---

<footer class="zx-footer">
  <div class="zx-container">
    <div class="zx-footer-grid">
      <div class="zx-footer-brand">
        <Logo variant="light" />
        <p>{FOOTER.blurb}</p>
      </div>

      {FOOTER.cols.map((col) => (
        <nav class="zx-footer-col" aria-label={col.title}>
          <p>{col.title}</p>
          {col.links.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
      ))}

      <div class="zx-footer-news">
        <p>Dicas de venda toda semana</p>
        <form class="zx-footer-form" data-news>
          <input type="email" name="email" placeholder="Seu melhor e-mail" required aria-label="Seu e-mail" />
          <button class="zx-btn zx-btn--white" type="submit">Assinar</button>
        </form>
        <span class="zx-footer-tip">Sem spam. Cancele quando quiser.</span>
      </div>
    </div>

    <div class="zx-footer-legal">
      <p>{FOOTER.legal}</p>
      <p>{FOOTER.company} · CNPJ {FOOTER.cnpj}</p>
    </div>
  </div>
</footer>

<style>
  .zx-footer {
    margin-top: 0;
    padding: clamp(96px, 18vh, 180px) 0 clamp(72px, 12vh, 120px);
    background: transparent;
    color: rgba(237, 237, 237, 0.72);
  }
  .zx-footer-grid {
    display: grid;
    grid-template-columns: 1.4fr repeat(3, 0.8fr) 1.2fr;
    gap: clamp(28px, 4vw, 56px);
  }
  .zx-footer-brand p { margin-top: 20px; font-size: 13.5px; line-height: 1.65; max-width: 260px; }

  .zx-footer-col { display: grid; gap: 12px; align-content: start; }
  .zx-footer-col p {
    font-family: var(--zx-mono);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(237, 237, 237, 0.45);
    margin-bottom: 8px;
  }
  .zx-footer-col a {
    font-size: 13.5px;
    color: rgba(237, 237, 237, 0.78);
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
    width: fit-content;
  }
  .zx-footer-col a:hover { color: #fff; transform: translateX(2px); }

  .zx-footer-news > p { font-size: 14px; font-weight: 700; color: #fff; }
  .zx-footer-form { display: flex; gap: 8px; margin-top: 16px; }
  .zx-footer-form input {
    flex: 1;
    min-width: 0;
    padding: 11px 14px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.05);
    color: #fff;
    font-size: 13.5px;
    outline: none;
    transition: border-color 0.2s ease;
  }
  .zx-footer-form input::placeholder { color: rgba(237, 237, 237, 0.4); }
  .zx-footer-form input:focus { border-color: var(--zx-lar); }
  .zx-footer-tip { display: block; margin-top: 10px; font-size: 11.5px; color: rgba(237, 237, 237, 0.4); }

  .zx-footer-legal {
    display: flex;
    align-items: center;
    gap: 12px 24px;
    justify-content: space-between;
    margin-top: clamp(64px, 12vh, 120px);
    padding-top: 32px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    flex-wrap: wrap;
  }
  .zx-footer-legal p { font-size: 12px; color: rgba(237, 237, 237, 0.45); }

  @media (max-width: 1000px) {
    .zx-footer-grid { grid-template-columns: 1fr 1fr; }
    .zx-footer-brand { grid-column: span 2; }
    .zx-footer-news { grid-column: span 2; }
  }

  /* NO CELULAR o rodapé começa perto (founder 15/09: "sobe tudo, tem muito
     espaço vazio do topo"): os 96 a 180px de respiro no topo existiam pra
     separar o rodapé do FECHO ("Toda a sua empresa"), que no celular saiu .
     sem ele, aquele respiro virou meia tela de preto antes da marca. */
  @media (max-width: 760px) {
    .zx-footer { padding: clamp(36px, 6vh, 56px) 0 clamp(40px, 7vh, 64px); }
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>("[data-news]").forEach((form) => {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const btn = form.querySelector("button");
      if (btn) {
        btn.textContent = "Assinado ✓";
        btn.setAttribute("disabled", "true");
      }
    });
  });
</script>
