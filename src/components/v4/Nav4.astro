---
// Nav da v4: topbar de anúncio + navegação fixa com blur ao rolar.
import Logo from "../site/Logo.astro";
import { SITE } from "../../data/content";
import { GetStartedButton } from "../ui/get-started-button";

// Announce bar desligada a pedido do founder (14/09); markup e CSS ficam pra religar.
const SHOW_TOPBAR = false;

/* Âncoras com a BARRA na frente: a mesma nav aparece na home e em /precos, e
   um "#segmentos" solto não leva a lugar nenhum fora da home. Na home o
   navegador trata "/#segmentos" como salto na própria página, sem recarregar.

   Três itens (founder 16/09: "fica só plataforma, soluções, blog e help center";
   17/09: "do header remove o plataforma, deixa só o soluções"): Preços e Dúvidas
   saíram da barra (a página /precos e o FAQ seguem existindo), e Plataforma saiu
   no dia seguinte. O Blog mora em /blog/ (outro deploy no mesmo domínio) e a
   Central de ajuda é o ajuda.voshq.com, que abre em outra aba. */
const LINKS = [
  { href: "/#segmentos", label: "Soluções" },
  { href: "/blog/", label: "Blog" },
  { href: "https://ajuda.voshq.com", label: "Central de ajuda", externo: true },
];

/* Item da página em que se está (só os que são página, não âncora). */
const aqui = Astro.url.pathname.replace(/\/$/, "");
const atual = (href: string) => (href.includes("#") ? false : href.replace(/\/$/, "") === aqui);
---

{SHOW_TOPBAR && (
<div class="zx-topbar" id="zx-topbar">
  <a href="#modulos">
    <strong>NOVO</strong>
    <span class="zx-topbar-dot" aria-hidden="true"></span>
    <span class="zx-topbar-msg">
      <span class="zx-topbar-full">Agora você conecta o VOS com seu</span>
      <span class="zx-topbar-short">Conecta o VOS com seu</span>
      <em>Claude</em>
      <img class="zx-topbar-claude" src="/assets/integrations/claude.svg" alt="" width="18" height="18" aria-hidden="true" />
    </span>
    <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </a>
</div>
)}

<header class="zx-nav" id="zx-nav">
  <div class="zx-nav-inner">
    <span class="zx-nav-logo zx-nav-logo--dark"><Logo /></span>
    <span class="zx-nav-logo zx-nav-logo--light"><Logo variant="light" /></span>
    <nav class="zx-nav-links" aria-label="Seções da página">
      {LINKS.map((l) => <a href={l.href} target={l.externo ? "_blank" : undefined} rel={l.externo ? "noopener" : undefined} aria-current={atual(l.href) ? "page" : undefined}>{l.label}</a>)}
    </nav>
    <div class="zx-nav-actions">
      <a class="zx-nav-login" href={SITE.signupUrl}>Entrar</a>
      <span class="zx-nav-cta">
        <GetStartedButton client:visible label="Criar conta" className="!py-2.5 !pl-4 !pr-3 !text-[14px] !leading-5" />
      </span>
    </div>
    <button class="zx-nav-burger" id="zx-burger" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="zx-mobile">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="zx-mobile" id="zx-mobile" hidden>
    {LINKS.map((l) => <a href={l.href} target={l.externo ? "_blank" : undefined} rel={l.externo ? "noopener" : undefined} aria-current={atual(l.href) ? "page" : undefined}>{l.label}</a>)}
    <div class="zx-mobile-cta">
      <GetStartedButton client:visible label="Criar conta" className="w-full justify-center" />
    </div>
  </div>
</header>

<style>
  .zx-topbar {
    position: relative;
    z-index: 60;
    background: var(--zx-panel);
    color: var(--zx-ink);
    font-size: 13px;
    letter-spacing: 0.01em;
    box-shadow: inset 0 -1px 0 var(--zx-line);
  }
  .zx-topbar a {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: nowrap;
    gap: 8px;
    padding: 9px 16px;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
  }
  .zx-topbar strong {
    font-weight: 700;
    letter-spacing: 0.04em;
    flex: 0 0 auto;
  }
  .zx-topbar-dot {
    width: 5px; height: 5px; border-radius: 999px;
    background: var(--zx-lar);
    flex: 0 0 auto;
  }
  .zx-topbar-msg {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-wrap: nowrap;
    white-space: nowrap;
    min-width: 0;
  }
  .zx-topbar-short { display: none; }
  /* Logo de terceiro é mono no repouso (UNO): o nome fica na tinta. */
  .zx-topbar-msg em {
    font-style: normal;
    font-weight: 650;
    color: var(--zx-ink);
  }
  .zx-topbar-claude {
    width: 18px;
    height: 18px;
    object-fit: contain;
    flex: 0 0 auto;
    display: block;
  }
  .zx-topbar a > svg { transition: transform 0.25s var(--ease-vos, ease); flex: 0 0 auto; }
  .zx-topbar a:hover > svg { transform: translateX(3px); }

  @media (max-width: 520px) {
    .zx-topbar { font-size: 12px; }
    .zx-topbar a { gap: 6px; padding: 8px 12px; }
    .zx-topbar-full { display: none; }
    .zx-topbar-short { display: inline; }
  }
  @media (max-width: 360px) {
    .zx-topbar strong,
    .zx-topbar-dot { display: none; }
    .zx-topbar a { gap: 5px; padding: 8px 10px; }
  }

  /* ── Ao rolar, a barra vira PÍLULA flutuante (founder 15/09, referência: a
     nav da Nuvemshop): solta do topo, afastada das bordas, papel com blur.

     A ALTURA do header não muda nunca: o `index.astro` desconta ela na margem
     do filme (`--zx-nav-h`), e um header que cresce ao rolar empurraria a
     página no meio da rolagem. Por isso a pílula é um FUNDO atrás do conteúdo
     (`::before`) e a descida é `transform`, que não ocupa lugar. ── */
  .zx-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: transparent;
  }
  .zx-nav-inner {
    position: relative;
    isolation: isolate;
    max-width: var(--zx-w);
    margin-inline: auto;
    padding: 14px clamp(16px, 4vw, 32px);
    display: flex;
    align-items: center;
    gap: 28px;
    transform: translateY(0);
    transition:
      transform 0.45s var(--zx-ease),
      padding 0.45s var(--zx-ease);
  }
  .zx-nav-inner::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 6px 14px;
    border-radius: 999px;
    /* quase opaca: a 90% o preto das seções de baixo tingia o papel de cinza */
    background: rgba(250, 250, 250, 0.96);
    -webkit-backdrop-filter: saturate(1.25) blur(14px);
    backdrop-filter: saturate(1.25) blur(14px);
    box-shadow:
      0 0 0 1px rgba(23, 23, 23, 0.06),
      0 14px 34px -18px rgba(8, 9, 10, 0.55);
    opacity: 0;
    transform: scale(0.97);
    pointer-events: none;
    transition:
      opacity 0.3s var(--zx-ease),
      transform 0.45s var(--zx-ease);
  }
  .zx-nav.is-scrolled .zx-nav-inner { transform: translateY(10px); }
  .zx-nav.is-scrolled .zx-nav-inner::before { opacity: 1; transform: none; }
  .zx-nav-links {
    display: flex;
    gap: 4px;
    margin-inline: auto;
  }
  .zx-nav-links a {
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    color: var(--zx-ink2);
    text-decoration: none;
    transition: color var(--zx-t-micro) var(--zx-ease), background var(--zx-t-micro) var(--zx-ease);
  }
  .zx-nav-links a:hover { color: var(--zx-ink); background: var(--zx-hover); }
  /* A página em que se está: tinta cheia, sem fundo . o grifo é o peso, não
     uma segunda pílula dentro da pílula. */
  .zx-nav-links a[aria-current="page"] { color: var(--zx-ink); font-weight: 600; }
  .zx-nav-actions { display: flex; align-items: center; gap: 14px; }
  .zx-nav-login {
    font-size: 14px;
    font-weight: 600;
    color: var(--zx-ink);
    text-decoration: none;
  }
  .zx-nav-login:hover { color: var(--zx-ink2); }

  .zx-nav-burger {
    display: none;
    flex-direction: column;
    gap: 4.5px;
    padding: 10px 8px;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .zx-nav-burger span {
    width: 20px; height: 2px;
    border-radius: 2px;
    background: var(--zx-ink);
    transition: transform 0.25s ease, opacity 0.2s ease;
  }
  .zx-nav-burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .zx-nav-burger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .zx-nav-burger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

  /* O menu aberto do celular é um cartão embaixo da pílula, na mesma curva de
     papel, e desce junto com ela quando a página já rolou. */
  .zx-mobile {
    display: none;
    flex-direction: column;
    gap: 4px;
    margin: 6px 8px 0;
    padding: 8px 20px 20px;
    border-radius: 20px;
    background: var(--zx-paper);
    box-shadow:
      0 0 0 1px rgba(23, 23, 23, 0.06),
      0 18px 40px -20px rgba(8, 9, 10, 0.55);
    transition: transform 0.45s var(--zx-ease);
  }
  .zx-nav.is-scrolled .zx-mobile { transform: translateY(10px); }
  .zx-mobile a:not(.zx-btn) {
    padding: 12px 4px;
    font-size: 16px;
    font-weight: 600;
    color: var(--zx-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--zx-line);
  }
  .zx-mobile-cta { margin-top: 14px; }
  .zx-mobile-cta :global(button), .zx-mobile-cta :global(a) { width: 100%; }

  @media (max-width: 900px) {
    .zx-nav-links, .zx-nav-login { display: none; }
    /* quem empurrava tudo pras pontas eram os links, que somem aqui: sem a
       margem o hambúrguer parava no meio da barra */
    .zx-nav-burger { display: flex; margin-left: auto; }
    .zx-mobile.is-open { display: flex; }
    .zx-nav-cta { display: none; }
    /* No celular a pílula chega a 8px da borda, e o conteúdo recua junto pra
       logo e hambúrguer não encostarem na curva dela. */
    .zx-nav-inner::before { inset: 6px 8px; }
    .zx-nav.is-scrolled .zx-nav-inner { padding-inline: 22px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .zx-nav-inner,
    .zx-nav-inner::before,
    .zx-mobile { transition: none; }
  }
</style>

<script>
  /* A barra sabe se comportar sozinha (15/09): isto morava no script da home,
     e a página de preço nascia com a nav sem estado de rolagem e o menu do
     celular mudo. */
  const nav = document.getElementById("zx-nav");
  /* Numa página com FILME, a barra não acende aos 8px de rolagem: o hero fica
     preso no fundo e continua atrás dela por uma tela inteira. Ela acende
     quando a FOLHA encosta nela, que é o instante em que o filme some de trás.
     Página sem filme (preço) cai no 8px de sempre. */
  const folha = document.querySelector(".zx--film .zx-sheet");
  const onScroll = () => {
    const acende = folha
      ? folha.getBoundingClientRect().top <= (nav?.offsetHeight ?? 64)
      : window.scrollY > 8;
    nav?.classList.toggle("is-scrolled", acende);
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const burger = document.getElementById("zx-burger");
  const mobile = document.getElementById("zx-mobile");
  burger?.addEventListener("click", () => {
    const open = burger.getAttribute("aria-expanded") === "true";
    burger.setAttribute("aria-expanded", String(!open));
    burger.setAttribute("aria-label", open ? "Abrir menu" : "Fechar menu");
    if (mobile) {
      mobile.hidden = open;
      mobile.classList.toggle("is-open", !open);
    }
  });
  mobile?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      burger?.setAttribute("aria-expanded", "false");
      if (mobile) { mobile.hidden = true; mobile.classList.remove("is-open"); }
    })
  );
</script>
