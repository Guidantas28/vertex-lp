  @media (prefers-reduced-motion: reduce) {
    /* parado e visível: quem pediu menos movimento ainda vê a prova */
    .zx-passos-aviso { animation: none; opacity: 1; transform: none; }
    /* a live para: fica UM comentário e UM coração, parados */
    .zx-live-fala { animation: none; }
