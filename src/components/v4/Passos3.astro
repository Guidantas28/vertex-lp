</style>

<script>
  /* A LIVE É AO VIVO: o número de quem está assistindo sobe de 2 em 2 a cada
     2 segundos (founder 15/09, "de vagarinho"). Para quando a foto sai da
     tela . e com menos movimento pedido nem começa, porque número trocando
     sozinho também é movimento. */
  const olhos = document.querySelector<HTMLElement>("[data-olhos]");
  if (olhos) {
    const menos = window.matchMedia("(prefers-reduced-motion: reduce)");
    let quantos = Number(olhos.textContent?.replace(/\D/g, "")) || 127;
    let relogio = 0;

    const parar = () => window.clearInterval(relogio);
    const ligar = () => {
      parar();
      if (menos.matches) return;
      relogio = window.setInterval(() => {
        quantos += 2;
        olhos.textContent = quantos.toLocaleString("pt-BR");
      }, 2000);
    };

    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entradas) => {
          if (entradas.some((e) => e.isIntersecting)) ligar();
          else parar();
        },
        { threshold: 0.2 },
      );
      io.observe(olhos);
    } else {
      ligar();
    }
  }
</script>
