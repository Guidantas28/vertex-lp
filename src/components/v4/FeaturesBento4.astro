---
// Bento de features do VOS (estilo ClickUp Brain²): grid escuro com hairlines
// e mockups vivos. Vive DENTRO do ScrollBand (fundo vem da faixa).
import FlowLive from "../islands/FlowLive.tsx";
import FunnelLive from "../islands/FunnelLive.tsx";
import FinanceLive from "../islands/FinanceLive.tsx";
import GestaoLive from "../islands/GestaoLive.tsx";

type Msg =
  | { kind: "in" | "out"; text: string; time: string }
  | { kind: "pay"; order: string; price: string; cta: string; icon: string };

type Conversa = {
  nome: string;
  foto: string;
  canal: "whatsapp" | "instagram" | "email";
  msgs: Msg[];
};

// Gente de verdade nas conversas: foto, nome e o ícone do canal em que ela chegou.
const CONVERSAS: Conversa[] = [
  {
    nome: "Carla Mendes",
    foto: "/assets/people/social-19.webp",
    canal: "whatsapp",
    msgs: [
      { kind: "in", text: "Oi! Vocês têm o modelo 42 em estoque?", time: "21:04" },
      { kind: "out", text: "Temos sim! Separei o seu com link de pagamento 👇", time: "21:05" },
      { kind: "pay", order: "Pedido #4812", price: "R$ 389,90", cta: "Pagar com PIX", icon: "/assets/icons/pix.svg" },
      { kind: "in", text: "Paguei! Quando chega?", time: "21:07" },
      { kind: "out", text: "PIX confirmado ✓ Sai pra entrega amanhã até 12h.", time: "21:07" },
    ],
  },
  {
    nome: "Patrícia Nunes",
    foto: "/assets/people/social-12.webp",
    canal: "instagram",
    msgs: [
      { kind: "in", text: "Ainda tem o vestido bege no M?", time: "21:12" },
      { kind: "out", text: "Tem 2 unidades. Quer que eu reserve pra você?", time: "21:13" },
      { kind: "in", text: "Reserva! Vou buscar hoje.", time: "21:13" },
      { kind: "out", text: "Reservado por 2h · te mando o endereço do balcão.", time: "21:14" },
    ],
  },
  {
    nome: "Sandra Moraes",
    foto: "/assets/people/social-14.webp",
    canal: "email",
    msgs: [
      { kind: "in", text: "Bom dia, preciso de 40 kits pro evento de sexta.", time: "09:12" },
      { kind: "out", text: "Bom dia! Montei o orçamento, chega em 2 dias úteis.", time: "09:14" },
      { kind: "pay", order: "Orçamento #882", price: "R$ 3.120,00", cta: "Aprovar orçamento", icon: "/assets/icons/nfe.svg" },
      { kind: "in", text: "Aprovado. Pode faturar.", time: "09:31" },
    ],
  },
  {
    nome: "Renato Alves",
    foto: "/assets/people/social-13.webp",
    canal: "whatsapp",
    msgs: [
      { kind: "in", text: "Dá pra parcelar o notebook em 6x?", time: "21:18" },
      { kind: "out", text: "Sim, 6x de R$ 249 no cartão. Fecho pra você?", time: "21:18" },
      { kind: "pay", order: "Pedido #4819", price: "R$ 1.494,00", cta: "Pagar no cartão", icon: "/assets/icons/nfe.svg" },
      { kind: "in", text: "Feito. Nota no CNPJ 12.345?", time: "21:20" },
      { kind: "out", text: "NF-e emitida e enviada no e-mail ✓", time: "21:21" },
    ],
  },
];

const CANAL_ICON: Record<string, string> = {
  whatsapp: "/assets/icons/whatsapp.svg",
  instagram: "/assets/icons/instagram.svg",
  email: "/assets/icons/email.svg",
};
const CANAL_NOME: Record<string, string> = {
  whatsapp: "WhatsApp",
  instagram: "Instagram",
  email: "E-mail",
};
---

<section class="zx-fbento" id="features">
  <div class="zx-container">
    <header class="zx-fbento-head">
      <h2 class="reveal">Tudo que sua empresa usa,<br />num sistema <strong>só</strong>.</h2>
      <p class="reveal reveal-delay-2">
        Agenda, vendas, ordens de serviço, WhatsApp e financeiro conversando entre si. Você cuida do negócio; o sistema cuida do resto.
      </p>
    </header>

    <div class="zx-fgrid">
      <!-- 1 · ATENDIMENTO (a jornada começa na conversa) -->
      <article class="zx-fcard reveal" data-depth="1">
        <h3>O time todo numa inbox só.</h3>
        <p class="zx-fcard-sub">Conversas viram histórico e venda, nada fica preso no celular de uma pessoa.</p>
        <div class="zx-fchat" aria-hidden="true">
          <div class="zx-fchat-viewport">
            <div class="zx-fchat-track">
              {[0, 1].map((dup) => (
                <div class="zx-fchat-seq" data-dup={dup}>
                  {CONVERSAS.map((c) => (
                    <div class="zx-fconv">
                      <div class={`zx-fconv-head is-${c.canal}`}>
                        <span class="zx-fconv-av">
                          <img src={c.foto} alt="" width="34" height="34" loading="lazy" decoding="async" />
                          <img class="zx-fconv-canal" src={CANAL_ICON[c.canal]} alt="" width="14" height="14" loading="lazy" />
                        </span>
                        <b>{c.nome}</b>
                        <em>{CANAL_NOME[c.canal]}</em>
                      </div>
                      {c.msgs.map((m) => (
                        m.kind === "pay" ? (
                          <div class="zx-fchat-card">
                            <span>{m.order} · {m.price}</span>
                            <b><img src={m.icon} alt="" width="15" height="15" loading="lazy" />{m.cta}</b>
                          </div>
                        ) : (
                          <div class={`zx-fchat-msg zx-fchat-msg--${m.kind}`}>
                            <p>{m.text}</p>
                            <em>{m.time}</em>
                          </div>
                        )
                      ))}
                    </div>
                  ))}
                </div>
              ))}
            </div>
          </div>
          <p class="zx-fcard-note"><i class="zx-fdot"></i>WhatsApp, Instagram e e-mail na mesma caixa</p>
        </div>
      </article>

      <!-- 2 · VENDA · a conversa vira negócio no funil -->
      <article class="zx-fcard reveal reveal-delay-1" data-depth="0.45">
        <h3>Funil que se move sozinho.</h3>
        <p class="zx-fcard-sub">Cada conversa vira oportunidade no estágio certo, sem digitar duas vezes.</p>
        <FunnelLive client:visible />
      </article>

      <!-- 3 · GESTÃO · produto, serviço e agenda ciclando por segmento -->
      <article class="zx-fcard reveal reveal-delay-2" data-depth="0.8">
        <h3>Produto, serviço e agenda sob controle.</h3>
        <p class="zx-fcard-sub">A venda baixa o estoque, vira ordem de serviço e entra na agenda. Você só acompanha.</p>
        <GestaoLive client:visible />
      </article>

      <!-- 4 · AUTOMAÇÃO (wide) · fluxos prontos + agentes seus -->
      <article class="zx-fcard zx-fcard--wide reveal" data-depth="0.35">
        <h3>Fluxos prontos. Ou monte seu próprio agente.</h3>
        <p class="zx-fcard-sub">Ative um fluxo pré-pronto com um clique: cobrança, agendamento, pós-venda. Precisa de algo seu? Crie um agente de IA do zero, sem programar.</p>
        <FlowLive client:visible />
      </article>

      <!-- 5 · FINANCEIRO · a jornada termina no caixa -->
      <article class="zx-fcard reveal reveal-delay-1" data-depth="0.9">
        <h3>Caixa em tempo real.</h3>
        <p class="zx-fcard-sub">Cada venda atualiza o fluxo na hora. NF-e e PIX nativos, sem integração.</p>
        <FinanceLive client:load />
      </article>
    </div>
  </div>
</section>

<style>
  .zx-fbento {
    position: relative;
    padding: clamp(24px, 4vh, 48px) 0 clamp(20px, 3vh, 32px);
    color: var(--zx-on-dark);
  }

  .zx-fbento-head {
    max-width: 720px;
    margin: 0 auto clamp(36px, 6vh, 56px);
    text-align: center;
  }
  .zx-fbento-head h2 {
    margin: 0;
    font-family: var(--zx-display);
    font-size: var(--zx-fs-title);
    line-height: var(--zx-lh-title);
    letter-spacing: var(--zx-ls-title);
    font-weight: var(--zx-fw-title-dark);
    color: var(--zx-on-dark);
    text-wrap: balance;
  }
  .zx-fbento-head h2 strong { font-weight: var(--zx-fw-emphasis); }
  .zx-fbento-head > p:last-child {
    margin: 16px auto 0;
    max-width: 540px;
    font-family: var(--zx-body);
    font-size: var(--zx-fs-body);
    font-weight: var(--zx-fw-body);
    line-height: var(--zx-lh-body);
    color: rgba(237, 237, 237, 0.62);
  }

  /* ── Grid 3 + 2 (estilo Brain²) ── */
  .zx-fgrid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .zx-fcard--wide { grid-column: span 3; }
  @media (min-width: 900px) {
    .zx-fcard--wide { grid-column: span 1; }
    .zx-fgrid > .zx-fcard--wide:nth-of-type(4) { grid-column: 1 / span 2; }
    .zx-fgrid > .zx-fcard--wide:nth-of-type(5) { grid-column: 3 / span 1; }
  }
  @media (max-width: 899px) {
    .zx-fgrid { grid-template-columns: 1fr; }
    .zx-fcard--wide { grid-column: auto; }
  }

  .zx-fcard {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 440px;
    padding: clamp(20px, 2.4vw, 28px);
    border-radius: var(--zx-r-card);
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.028);
    overflow: hidden;
    transition: border-color 0.35s var(--zx-ease), background 0.35s var(--zx-ease);
    will-change: transform;
    /* --d = parallax do scroll (o script escreve), --h = levanta no hover */
    transform: translate3d(0, calc(var(--d, 0px) + var(--h, 0px)), 0);
  }
  .zx-fcard:hover {
    --h: -3px;
    border-color: rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.05);
  }
  /* fio de luz que corre no topo do card quando ele entra na tela */
  .zx-fcard::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.5), transparent);
    opacity: 0;
    transform: translateX(-100%);
  }
  /* AMBIENTE: a maré de luz do card respira em 14s, com amplitude de 1% do
     movimento principal. É o que tira o ar de tela congelada entre um evento
     e outro; a régua diz que ambiente nunca disputa atenção. */
  .zx-fcard::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(70% 55% at 50% 108%, rgba(237, 75, 0, 0.1), transparent 70%);
    animation: zx-fmare 14s ease-in-out infinite;
  }
  .zx-fcard > * { position: relative; z-index: 1; }
  @keyframes zx-fmare {
    0%, 100% { opacity: 0.45; }
    50% { opacity: 1; }
  }
  .zx-fcard:nth-of-type(2)::after { animation-duration: 17s; animation-delay: -5s; }
  .zx-fcard:nth-of-type(3)::after { animation-duration: 12s; animation-delay: -9s; }
  .zx-fcard:nth-of-type(4)::after { animation-duration: 19s; animation-delay: -3s; }
  .zx-fcard:nth-of-type(5)::after { animation-duration: 15s; animation-delay: -12s; }
  .zx-fcard.is-visible::before {
    animation: zx-fsweep 0.9s var(--zx-ease) 0.12s both;
  }
  @keyframes zx-fsweep {
    0% { opacity: 0; transform: translateX(-100%); }
    35% { opacity: 1; }
    100% { opacity: 0; transform: translateX(100%); }
  }

  /* Título de card (t7): Inter, peso médio. O Fio é só pra display grande. */
  .zx-fcard h3 {
    margin: 0;
    font-family: var(--zx-body);
    font-size: clamp(18px, 1.8vw, 20px);
    font-weight: 550;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: var(--zx-on-dark);
    text-wrap: balance;
  }
  .zx-fcard-sub {
    margin: 8px 0 0;
    font-size: 13.5px;
    line-height: 1.55;
    color: rgba(237, 237, 237, 0.6);
  }
  .zx-fcard-note {
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 14px 0 0;
    font-size: 11.5px;
    color: rgba(237, 237, 237, 0.5);
  }

  .zx-fdot {
    width: 6px; height: 6px;
    border-radius: 99px;
    background: var(--zx-ok-dark);
    box-shadow: 0 0 0 0 rgba(61, 190, 122, 0.5);
    animation: zx-fping 2.4s ease-out infinite;
  }
  @keyframes zx-fping {
    0% { box-shadow: 0 0 0 0 rgba(61, 190, 122, 0.45); }
    70%, 100% { box-shadow: 0 0 0 7px rgba(61, 190, 122, 0); }
  }

  /* ── 2 · Chat live (scroll infinito) ── */
  .zx-fchat { margin-top: 18px; display: flex; flex-direction: column; gap: 10px; flex: 1; min-height: 0; }
  .zx-fchat-viewport {
    position: relative;
    /* altura FIXA: com flex o track inteiro empurrava o card pra 3 mil px */
    height: clamp(300px, 34vh, 380px);
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.07);
    background:
      radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1.4px),
      linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 40%);
    background-size: 18px 18px, auto;
    background-color: rgba(0, 0, 0, 0.18);
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 12%, #000 88%, transparent 100%);
    mask-image: linear-gradient(180deg, transparent 0%, #000 12%, #000 88%, transparent 100%);
  }
  .zx-fchat-track {
    display: flex;
    flex-direction: column;
    will-change: transform;
    animation: zx-fchat-scroll 48s linear infinite;
  }
  .zx-fchat:hover .zx-fchat-track { animation-play-state: paused; }
  .zx-fchat-seq {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 14px 12px;
  }
  @keyframes zx-fchat-scroll {
    from { transform: translateY(0); }
    to { transform: translateY(-50%); }
  }

  .zx-fchat-msg {
    position: relative;
    max-width: 88%;
    padding: 9px 12px;
    border-radius: 12px;
    font-size: 12.5px;
    line-height: 1.45;
  }
  .zx-fchat-msg p { margin: 0; color: rgba(255, 255, 255, 0.9); }
  .zx-fchat-msg em { display: block; margin-top: 3px; font-style: normal; font-size: 10px; color: rgba(255, 255, 255, 0.38); text-align: right; }
  .zx-fchat-msg--in {
    align-self: flex-start;
    background: rgba(255, 255, 255, 0.055);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-bottom-left-radius: 4px;
  }
  .zx-fchat-msg--out {
    align-self: flex-end;
    background: color-mix(in srgb, var(--zx-info-dark) 18%, transparent);
    border: 1px solid color-mix(in srgb, var(--zx-info-dark) 34%, transparent);
    border-bottom-right-radius: 4px;
  }
  /* SECUNDÁRIA: um brilho atravessa o cartão de pagamento a cada 9s. A régua
     chama de shimmer e reserva pra acento premium; aqui ele diz "isto é o
     dinheiro" sem piscar nem gritar. */
  .zx-fchat-card {
    position: relative;
    overflow: hidden;
    align-self: flex-end;
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: 88%;
    padding: 10px 12px;
    border-radius: 12px;
    border: 1px dashed color-mix(in srgb, var(--zx-info-dark) 45%, transparent);
    background: rgba(255, 255, 255, 0.02);
  }
  .zx-fchat-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 38%, rgba(255, 255, 255, 0.16) 50%, transparent 62%);
    transform: translateX(-130%);
    animation: zx-fbrilho 9s cubic-bezier(0.22, 1, 0.36, 1) infinite;
    pointer-events: none;
  }
  @keyframes zx-fbrilho {
    0%, 78% { transform: translateX(-130%); }
    92%, 100% { transform: translateX(130%); }
  }
  .zx-fchat-card span { font-size: 11.5px; color: rgba(255, 255, 255, 0.66); }
  .zx-fchat-card b {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    font-size: 12px;
    color: #fff;
    padding: 7px 10px;
    border-radius: 8px;
    background: color-mix(in srgb, var(--zx-info-dark) 34%, transparent);
  }
  .zx-fchat-card b img { display: block; width: 15px; height: 15px; }
  /* Cabeçalho da conversa: a foto da pessoa e o selo do canal em que ela chegou.
     Cor aqui vem de fonte REAL (foto e logo de terceiro), não de cor inventada. */
  .zx-fconv { display: flex; flex-direction: column; gap: 8px; }
  .zx-fconv + .zx-fconv { margin-top: 14px; padding-top: 14px; border-top: 1px solid rgba(255, 255, 255, 0.07); }
  .zx-fconv-head {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 2px;
  }
  .zx-fconv-av {
    position: relative;
    flex: 0 0 auto;
    width: 34px;
    height: 34px;
  }
  .zx-fconv-av > img:first-child {
    width: 34px;
    height: 34px;
    border-radius: 999px;
    object-fit: cover;
    object-position: top center;
    border: 1.5px solid rgba(255, 255, 255, 0.18);
  }
  .zx-fconv-canal {
    position: absolute;
    right: -3px;
    bottom: -3px;
    width: 15px;
    height: 15px;
    border-radius: 999px;
    background: #0b0d0f;
    padding: 1.5px;
    box-shadow: 0 0 0 1.5px #0b0d0f;
  }
  .zx-fconv-head b {
    font-size: 12.5px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.92);
  }
  /* Canal é CATEGORIA: chip do produto, sem marcador de estado. */
  .zx-fconv-head em {
    font-style: normal;
    font-family: var(--zx-body);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    padding: 2px 8px;
    border-radius: 6px;
    color: rgba(237, 237, 237, 0.7);
    background: rgba(255, 255, 255, 0.07);
    border: 0;
  }
  .zx-fconv-head.is-whatsapp em { color: #4ADE80; background: rgba(37, 211, 102, 0.14); }
  .zx-fconv-head.is-instagram em { color: #F58FB0; background: rgba(225, 48, 108, 0.16); }
  .zx-fconv-head.is-email em { color: #8FB6FF; background: rgba(77, 141, 255, 0.16); }

  @media (prefers-reduced-motion: reduce) {
    .zx-fcard { transition: none; }
    .zx-fcard::after, .zx-fchat-card::after { animation: none; }
    .zx-fcard:hover { transform: none; }
    .zx-fchat-track { animation: none; }
    .zx-fdot { animation: none; }
    .zx-fchat-viewport { -webkit-mask-image: none; mask-image: none; overflow: auto; }
  }
</style>

<!-- Estilos do GestaoLive (island React → precisa ser global) -->
<style is:global>
  .zx-fnotif {
    display: flex;
    flex-direction: column;
    flex: 1;
    margin-top: 16px;
    min-height: 0;
  }
  .zx-fnotif-stack { justify-content: flex-start; }
  .zx-fnotif-stack {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
    overflow: hidden;
    /* a mais antiga esvai por baixo, como central de notificações */
    -webkit-mask-image: linear-gradient(180deg, #000 74%, transparent 99%);
    mask-image: linear-gradient(180deg, #000 74%, transparent 99%);
  }
  .zx-fnotif-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.09);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.028));
    box-shadow: 0 14px 30px -18px rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(6px);
  }
  /* A arte é REAL: logo do canal, marca do PIX, foto do produto ou a cara do cliente.
     Marca e produto em moldura quadrada; gente em moldura redonda. */
  .zx-fnotif-ico {
    display: grid;
    place-items: center;
    width: 38px; height: 38px;
    flex: 0 0 auto;
    border-radius: 11px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }
  .zx-fnotif-ico img { display: block; width: 21px; height: 21px; object-fit: contain; }
  .zx-fnotif-ico.is-round { border-radius: 999px; }
  .zx-fnotif-ico.is-round img { width: 100%; height: 100%; object-fit: cover; object-position: top center; }
  /* foto de produto preenche a moldura quadrada */
  .zx-fnotif-ico:not(.is-round) img[src*=".webp"] { width: 100%; height: 100%; object-fit: cover; }
  .zx-fnotif-txt { min-width: 0; }
  .zx-fnotif-txt strong {
    display: flex;
    align-items: center;
    gap: 7px;
    min-width: 0;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--zx-on-dark);
  }
  /* o título trunca; o chip "agora" nunca encolhe nem é cortado */
  .zx-fnotif-txt strong > span:first-child {
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* A notificação nova se marca pela RÉGUA DE ACENTO na borda, não por um chip
     "agora" disputando espaço com o título (que truncava). */
  .zx-fnotif-card.is-fresh {
    border-color: rgba(237, 75, 0, 0.32);
    box-shadow: inset 3px 0 0 var(--zx-lar), 0 14px 30px -18px rgba(0, 0, 0, 0.65);
  }
  .zx-fnotif-txt span {
    display: block;
    margin-top: 2px;
    font-size: 11.5px;
    color: rgba(237, 237, 237, 0.55);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* O chip é o do produto: a classe .zx-chip manda na forma e na cor. */
  .zx-fnotif-card em {
    margin-left: auto;
    flex: 0 0 auto;
    font-style: normal;
  }
  .zx-fnotif .zx-fcard-note {
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 12px 0 0;
    font-size: 11.5px;
    color: rgba(237, 237, 237, 0.5);
  }
  .zx-fnotif .zx-fdot {
    width: 6px; height: 6px;
    border-radius: 99px;
    background: var(--zx-ok-dark);
    animation: zx-fping 2.4s ease-out infinite;
    flex: 0 0 auto;
  }
</style>

<script>
  // Parallax de scroll do bento: cada card anda numa profundidade própria
  // (data-depth), então a grade "respira" em vez de subir em bloco.
  const cards = Array.from(document.querySelectorAll<HTMLElement>(".zx-fcard[data-depth]"));
  if (cards.length && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const vh = window.innerHeight;
      for (const card of cards) {
        const r = card.getBoundingClientRect();
        if (r.bottom < -200 || r.top > vh + 200) continue;
        // -1 (entrando por baixo) → 1 (saindo por cima)
        const p = (r.top + r.height / 2 - vh / 2) / vh;
        const depth = Number(card.dataset.depth || "0.5");
        card.style.setProperty("--d", `${(p * -34 * depth).toFixed(1)}px`);
      }
    };
    addEventListener("scroll", () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    addEventListener("resize", update, { passive: true });
    update();
  }
</script>
