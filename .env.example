# Endpoint público de captura de lead no backend do vos (server-to-server).
VOS_LEAD_ENDPOINT="http://localhost:4000/public/marketing-lead"
# Segredo opcional compartilhado (header X-Lead-Secret) — defense in depth.
VOS_LEAD_SECRET=""
# Link de booking do Cal.com self-hosted (evento público "Equipe · VOS").
PUBLIC_CAL_LINK="vos/diagnostico"
PUBLIC_CAL_ORIGIN="https://cal.osvertex.com"
# Convidados fixos de toda reserva (recebem o convite do Google Meet), separados
# por vírgula. Variável PUBLIC_*: entra no bundle no BUILD — o deploy é
# `--prebuilt`, então o valor tem de estar no .env local na hora do `npm run build`.
PUBLIC_CAL_GUESTS="pessoa1@exemplo.com,pessoa2@exemplo.com"
# Para onde o usuário é levado após virar lead (app do vos).
PUBLIC_SIGNUP_URL="http://localhost:3001/signup"
